          "solution": "Doğru cevap A'dir. 'Hiçbiri' olumsuz özne olduğu için olumlu 'yapıyordu' yüklemine bağlanamaz; 'hepsi kendi bildiğini yapıyordu' denmelidir."
        },
        {
          "id": "e4_q16",
          "no": 16,
          "subject": "Türkçe",
          "text": "Paragraf (Akışı Bozan): (I) Bozkırda bahar kısa ama görkemlidir. (II) Karlar erir erimez her yer rengarenk çiçeklerle donanır. (III) Tarım arazilerinin sulanması için baraj inşaatları sürdürülmektedir. (IV) Ancak yazın sıcağı bastırınca bu cümbüş yerini sarı bir sessizliğe bırakır. (V) Doğa bir sonraki bahara kadar uykuya çekilir.\n\nAkışı bozan cümle hangisidir?",
          "options": [
            "A) V",
            "B) IV",
            "C) I",
            "D) III",
            "E) II"
          ],
          "correct": 3,
          "solution": "Doğru cevap C'dir. III. cümle doğa anlatımı arasına giren alakasız bir ekonomik faaliyettir."
        },
        {
          "id": "e4_q17",
          "no": 17,
          "subject": "Türkçe",
          "text": "Paragraf (İkiye Bölme): Bir metinde yeni bir düşünce veya konunun farklı bir boyutuna geçilen cümle paragrafı ikiye böler. Bu kurala göre metin mantıksal olarak nereden ayrılmalıdır?",
          "options": [
            "A) Konunun yön değiştirdiği cümleden",
            "B) İlk cümleden",
            "C) Soru cümlesinden",
            "D) En son cümleden",
            "E) En kısa cümleden"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. Paragraf bölme sorularında konu/bakış açısı değişikliği esastır."
        },
        {
          "id": "e4_q18",
          "no": 18,
          "subject": "Türkçe",
          "text": "Yazım Kuralı (Tarihler): Aşağıdakilerin hangisinde belirli bir tarih bildiren gün ve ay adlarının yazımı DOĞRUDUR?",
          "options": [
            "A) 1995 yılı haziranında",
            "B) 29 ekim 1923",
            "C) geçen pazartesi günü",
            "D) 29 Ekim 1923 Pazartesi",
            "E) eylül ayında"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dir. Belirli gün ve ay adları (rakamla belirtilen) büyük harfle başlar."
        },
        {
          "id": "e4_q19",
          "no": 19,
          "subject": "Türkçe",
          "text": "Yazım Kuralı (Bileşik Fiiller): Aşağıdaki cümlelerin hangisinde 'etmek/olmak' ile kurulan bileşik fiilin yazımı YANLIŞTIR?",
          "options": [
            "A) Bu durum beni çok <u>rahatsız etti</u>.",
            "B) Yapılan yardımı <u>kabul etti</u>.",
            "C) Durumu hemen <u>fark etti</u>.",
            "D) Bütün borçlarını <u>terk etti</u>.",
            "E) Haberi duyunca <u>kahır oldu</u>."
          ],
          "correct": 4,
          "solution": "Doğru cevap C'dir. Ses düşmesi olduğu için 'kahroldu' bitişik yazılmalıdır ('kahır oldu' yanlıştır)."
        },
        {
          "id": "e4_q20",
          "no": 20,
          "subject": "Türkçe",
          "text": "Söz Sanatları (Benzetme): \"Gözleri bir çift kömür gibi parlıyordu.\" cümlesinde hangi söz sanatı vardır?",
          "options": [
            "A) Teşbih (Benzetme)",
            "B) Tezat",
            "C) Mecaz-ı Mürsel",
            "D) Teşhis",
            "E) İstiare"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. 'Gibi' edatıyla kömüre benzetme yapılmıştır."
        },
        {
          "id": "e4_q21",
          "no": 21,
          "subject": "Türkçe",
          "text": "Söz Sanatları (Kişileştirme): \"Rüzgâr dağların ardından usulca fısıldadı.\" cümlesindeki söz sanatı nedir?",
          "options": [
            "A) Mübalağa",
            "B) Tenasüp",
            "C) Tariz",
            "D) Telmih",
            "E) Teşhis (Kişileştirme)"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. İnsana ait fısıldama özelliği rüzgâra verilmiştir."
        },
        {
          "id": "e4_q22",
          "no": 22,
          "subject": "Türkçe",
          "text": "Anlatım İlkeleri (Duruluk): Bir cümlede gereksiz sözcük kullanılmaması hangi anlatım ilkesidir?",
          "options": [
            "A) Özgünlük",
            "B) Doğallık",
            "C) Açıklık",
            "D) Duruluk",
            "E) Akıcılık"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dir. Gereksiz sözcükten arınmışlık 'duruluk'tur."
        },
        {
          "id": "e4_q23",
          "no": 23,
          "subject": "Türkçe",
          "text": "Anlatım İlkeleri (Açıklık): Cümlenin tek bir anlama gelmesi ve çok anlamlılık taşımaması hangi ilkedir?",
          "options": [
            "A) Duruluk",
            "B) Yalınlık",
            "C) Açıklık",
            "D) Akıcılık",
            "E) Özlülük"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. Herkesin aynı şeyi anlaması 'açıklık' ilkesidir."
        },
        {
          "id": "e4_q24",
          "no": 24,
          "subject": "Türkçe",
          "text": "Noktalama (Kesme İşareti): Aşağıdakilerin hangisinde kesme işareti (') YANLIŞ kullanılmıştır?",
          "options": [
            "A) Atatürk'ün ilkeleri",
            "B) Konya'ya",
            "C) TBMM'nin kararı",
            "D) Türkler'in tarihi",
            "E) 1923'te"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dir. Özel adlara gelen yapım ekleri ve çokluk eki (-ler) kesmeyle ayrılmaz: 'Türklerin' olmalıdır."
        },
        {
          "id": "e4_q25",
          "no": 25,
          "subject": "Türkçe",
          "text": "Noktalama (İki Nokta): Kendisinden sonra örnek verilecek cümlenin sonuna hangi noktalama işareti konur?",
          "options": [
            "A) İki nokta (:)",
            "B) Kısa çizgi (-)",
            "C) Virgül (,)",
            "D) Üç nokta (...)",
            "E) Noktalı virgül (;)"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. Örnek veya açıklama öncesinde iki nokta kullanılır."
        },
        {
          "id": "e4_q26",
          "no": 26,
          "subject": "Türkçe",
          "text": "Paragrafta Boşluk: Bir paragrafta 'Oysa' bağlacıyla başlayan cümle kendisinden önceki yargıyla nasıl bir ilişki kurar?",
          "options": [
            "A) Örneklendirme",
            "B) Benzetme",
            "C) Sebep-sonuç",
            "D) Sıralama",
            "E) Karşıtlık ve çelişki"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. 'Oysa' bağlacı önceki düşünceye zıt bir durumu bildirir."
        },
        {
          "id": "e4_q27",
          "no": 27,
          "subject": "Türkçe",
          "text": "Sözel Mantık (Eleme): Beş kişinin yarıştığı bir maratonda Ali, Veli'den önce; Can ise Ali'den önce bitirmiştir. Yarışın sonuncusu kim olamaz?",
          "options": [
            "A) Hepsi",
            "B) Bilinemez",
            "C) Diğerleri",
            "D) Veli",
            "E) Can"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. Can en az iki kişinin önünde olduğu için sonuncu olamaz."
        },
        {
          "id": "e4_q28",
          "no": 28,
          "subject": "Türkçe",
          "text": "Deyimler (Öfke): Aşağıdaki deyimlerden hangisi öfkelenmek anlamı taşımaz?",
          "options": [
            "A) Ağzı kulaklarına varmak",
            "B) Burnundan solumak",
            "C) Ateş püskürmek",
            "D) Cinleri tepesine toplanmak",
            "E) Tepesi atmak"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. 'Ağzı kulaklarına varmak' çok sevinmek demektir."
        },
        {
          "id": "e4_q29",
          "no": 29,
          "subject": "Türkçe",
          "text": "Atasözleri: 'Damlaya damlaya göl olur' atasözü hangi erdemi öğütler?",
          "options": [
            "A) Çalışkanlık",
            "B) Cesaret",
            "C) Tasarruf ve sabır",
            "D) Dürüstlük",
            "E) Misafirperverlik"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. Küçük birikimlerin zamanla büyüyeceğini, tasarrufu öğütler."
        },
        {
          "id": "e4_q30",
          "no": 30,
          "subject": "Türkçe",
          "text": "Metin Türleri: Yazarın güncel bir konuyu samimi bir dille, kanıtlama amacı gütmeden kaleme aldığı yazı türü hangisidir?",
          "options": [
            "A) Makale",
            "B) Otobiyografi",
            "C) Biyografi",
            "D) Deneme / Fıkra",
            "E) Tiyatro"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dir. Öznel ve samimi fikir yazısı denemedir."
        },
        {
          "id": "e4_q31",
          "no": 31,
          "subject": "Matematik",
          "text": "(1 - 1/3) · (1 - 1/4) · ... · (1 - 1/13)\n\nİşleminin sonucu kaçtır?",
          "options": [
            "A) 1/13",
            "B) 2/13",
            "C) 3/13",
            "D) 2/13",
            "E) 1/2"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Parantez içleri sadeleştiğinde ilk terimin payı (2) ile son terimin paydası (13) kalır: 2/13."
        },
        {
          "id": "e4_q32",
          "no": 32,
          "subject": "Matematik",
          "text": "2^(x) + 2^(x+1) = 96 olduğuna göre x kaçtır?",
          "options": [
            "A) 6",
            "B) 4",
            "C) 7",
            "D) 5",
            "E) 8"
          ],
          "correct": 3,
          "solution": "Doğru cevap B'dir. 2^x(1 + 2) = 96 => 3 · 2^x = 96 => 2^x = 32 = 2^5 => x = 5."
        },
        {
          "id": "e4_q33",
          "no": 33,
          "subject": "Matematik",
          "text": "√(36) + √(16) - √(9) işleminin sonucu kaçtır?",
          "options": [
            "A) 6",
            "B) 7",
            "C) 9",
            "D) 5",
            "E) 10"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. √36 = 6, √16 = 4, √9 = 3. 6 + 4 - 3 = 7."
        },
        {
          "id": "e4_q34",
          "no": 34,
          "subject": "Matematik",
          "text": "Ardışık üç çift tam sayının toplamı 60 olduğuna göre en küçük sayı kaçtır?",
          "options": [
            "A) 20",
            "B) 24",
            "C) 16",
            "D) 18",
            "E) 22"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Sayılar x, x+2, x+4 olsun. 3x + 6 = 60 => 3x = 54 => x = 18."
        },
        {
          "id": "e4_q35",
          "no": 35,
          "subject": "Matematik",
          "text": "Dört basamaklı 4A55 sayısı 9 ile tam bölünebilmektedir. Buna göre A rakamı kaçtır?",
          "options": [
            "A) 7",
            "B) 6",
            "C) 2",
            "D) 4",
            "E) 5"
          ],
          "correct": 3,
          "solution": "Doğru cevap B'dir. Rakamlar toplamı 9'un katı olmalıdır. e + A + (9 - e) + 5 = 14 + A => 14 + A = 18 => A = 4."
        },
        {
          "id": "e4_q36",
          "no": 36,
          "subject": "Matematik",
          "text": "20 ve 30 sayılarının EBOB'u kaçtır?",
          "options": [
            "A) 5",
            "B) 20",
            "C) 1",
            "D) 30",
            "E) 10"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. 20 = 10 · 2 ve 30 = 10 · 3 olup 2 ile 3 aralarında asaldır; EBOB = 10."
        },
        {
          "id": "e4_q37",
          "no": 37,
          "subject": "Matematik",
          "text": "-3 < 2x - 1 ≤ 13 eşitsizliğini sağlayan x tam sayılarının sayısı kaçtır?",
          "options": [
            "A) 6",
            "B) 8",
            "C) 7",
            "D) 9",
            "E) 5"
          ],
          "correct": 2,
          "solution": "Doğru cevap B'dir. -2 < 2x ≤ 14 => -1 < x ≤ 7. x tam sayıları: 0, 1, 2, ..., 7 olup toplam 8 değer değil, 7 tane pozitif ve 0 ile toplam 8 adettir."
        },
        {
          "id": "e4_q38",
          "no": 38,
          "subject": "Matematik",
          "text": "|x - 7| = 9 denklemini sağlayan x değerlerinin toplamı kaçtır?",
          "options": [
            "A) 7",
            "B) 0",
            "C) 14",
            "D) 18",
            "E) 9"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. |x - a| = b denkleminin kökleri a + b ve a - b olup toplamları daima 2a = 14 olur."
        },
        {
          "id": "e4_q39",
          "no": 39,
          "subject": "Matematik",
          "text": "Birbirine bağlı iki dişli çarktan büyüğünün 16 dişi, küçüğünün 8 dişi vardır. Büyük çark 10 tur attığında küçük çark kaç tur atar?",
          "options": [
            "A) 15",
            "B) 30",
            "C) 35",
            "D) 25",
            "E) 20"
          ],
          "correct": 4,
          "solution": "Doğru cevap B'dir. Diş sayısı ile tur sayısı ters orantılıdır: (2k) · 10 = k · x => x = 20 tur."
        },
        {
          "id": "e4_q40",
          "no": 40,
          "subject": "Matematik",
          "text": "Bir çiftlikte toplam 33 adet tavuk ve koyun bulunmaktadır. Bu hayvanların toplam ayak sayısı 94 olduğuna göre çiftlikte kaç koyun vardır?",
          "options": [
            "A) 18",
            "B) 12",
            "C) 19",
            "D) 16",
            "E) 14"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. Tavuk sayısı t, koyun k olsun. t + k = 33 ve 2t + 4k = 94. Çözüldüğünde k = 14 bulunur."
        },
        {
          "id": "e4_q41",
          "no": 41,
          "subject": "Matematik",
          "text": "Bir su deposunun 3/7'si doludur. Depoya 40 litre daha su eklenince deponun yarısı dolduğuna göre deponun tamamı kaç litre su alır?",
          "options": [
            "A) 560",
            "B) 480",
            "C) 420",
            "D) 520",
            "E) 600"
          ],
          "correct": 0,
          "solution": "Doğru cevap D'dir. Depo hacmi 14x olsun. Başlangıçta 6x doludur. 6x + 40 = 7x => x = 40. Depo tamamı = 14 · 40 = 560 litredir."
        },
        {
          "id": "e4_q42",
          "no": 42,
          "subject": "Matematik",
          "text": "Bir annenin bugünkü yaşı 38, çocuğunun yaşı ise 12'dir. Kaç yıl önce annenin yaşı çocuğunun yaşının 3 katıydı?",
          "options": [
            "A) 4",
            "B) 6",
            "C) 5",
            "D) 3",
            "E) 7"
          ],
          "correct": 2,
          "solution": "Doğru cevap C'dir. 38 - x = 3(12 - x) => 38 - x = 36 - 3x => 2x = -2 => x = 5 yıl önce."
        },
        {
          "id": "e4_q43",
          "no": 43,
          "subject": "Matematik",
          "text": "Bir usta bir günde 4 çift ayakkabı, kalfası ise bir günde 2 çift ayakkabı yapabilmektedir. İkisi birlikte 90 çift ayakkabıyı kaç günde bitirir?",
          "options": [
            "A) 15",
            "B) 12",
            "C) 14",
            "D) 18",
            "E) 16"
          ],
          "correct": 0,
          "solution": "Doğru cevap C'dir. Birlikte bir günde 4 + 2 = 6 çift ayakkabı yaparlar. 90 / 6 = 15 günde bitirirler."
        },
        {
          "id": "e4_q44",
          "no": 44,
          "subject": "Matematik",
          "text": "Aralarında 528 km mesafe bulunan iki şehirden hızları saatte 78 km ve 98 km olan iki araç aynı anda birbirine doğru hareket ederse kaç saat sonra karşılaşırlar?",
          "options": [
            "A) 2",
            "B) 2,5",
            "C) 3",
            "D) 3,5",
            "E) 4"
          ],
          "correct": 2,
          "solution": "Doğru cevap C'dir. t = Yol / (Hızlar Toplamı) = 528 / (78 + 98) = 528 / 176 = 3 saat."
        },
        {
          "id": "e4_q45",
          "no": 45,
          "subject": "Matematik",
          "text": "Maliyeti 240 TL olan bir ürün %25 kâr ile kaç TL'ye satılır?",
          "options": [
            "A) 310",
            "B) 320",
            "C) 290",
            "D) 300",
            "E) 280"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Satış Fiyatı = 240 · 1,25 = 300 TL."
        },
        {
          "id": "e4_q46",
          "no": 46,
          "subject": "Matematik",
          "text": "Tuz oranı %30 olan 40 gram tuzlu su ile tuz oranı %50 olan 60 gram tuzlu su karıştırılıyor. Yeni karışımın tuz oranı yüzde kaçtır?",
          "options": [
            "A) %44",
            "B) %38",
            "C) %42",
            "D) %40",
            "E) %46"
          ],
          "correct": 2,
          "solution": "Doğru cevap C'dir. Tuz = (40 · 0,30) + (60 · 0,50) = 12 + 30 = 42 gram. Toplam karışım = 100 gram. Yüzde = %42."
        },
        {
          "id": "e4_q47",
          "no": 47,
          "subject": "Matematik",
          "text": "(109)² - (99)² işleminin sonucu kaçtır?",
          "options": [
            "A) 2500",
            "B) 2080",
            "C) 2100",
            "D) 1800",
            "E) 2400"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. a² - b² = (a - b)(a + b) = (10) · (208) = 2080."
        },
        {
          "id": "e4_q48",
          "no": 48,
          "subject": "Matematik",
          "text": "A ve B iki küme olmak üzere, s(A) = 12, s(B) = 15 ve s(A ∩ B) = 4 olduğuna göre s(A ∪ B) kaçtır?",
          "options": [
            "A) 23",
            "B) 21",
            "C) 25",
            "D) 27",
            "E) 31"
          ],
          "correct": 0,
          "solution": "Doğru cevap B'dir. s(A ∪ B) = s(A) + s(B) - s(A ∩ B) = 12 + 15 - 4 = 23."
        },
        {
          "id": "e4_q49",
          "no": 49,
          "subject": "Matematik",
          "text": "4, 6, 7, 7, 8, 9, 11 veri grubunun medyanı (ortancası) kaçtır?",
          "options": [
            "A) 7",
            "B) 6",
            "C) 8",
            "D) 7,5",
            "E) 9"
          ],
          "correct": 0,
          "solution": "Doğru cevap B'dir. Küçükten büyüğe sıralı 7 elemanlı grubun ortanca (4.) elemanı 7'dir."
        },
        {
          "id": "e4_q50",
          "no": 50,
          "subject": "Matematik",
          "text": "Bir torbada 4 mavi, 5 kırmızı ve 3 sarı bilye vardır. Rastgele çekilen bir bilyenin kırmızı olma olasılığı kaçtır?",
          "options": [
            "A) 1/4",
            "B) 5/12",
            "C) 1/3",
            "D) 1/2",
            "E) 5/7"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Toplam bilye = 4 + 5 + 3 = 12. İstenen = 5 kırmızı. Olasılık = 5 / 12."
        },
        {
          "id": "e4_q51",
          "no": 51,
          "subject": "Matematik",
          "text": "Bir üçgenin iç açıları 3, 4 ve 5 sayıları ile orantılıdır. En küçük iç açı kaç derecedir?",
          "options": [
            "A) 60°",
            "B) 75°",
            "C) 50°",
            "D) 45°",
            "E) 80°"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dir. 3k + 4k + 5k = 180° => 12k = 180° => k = 15°. En küçük = 3 · 15° = 45°."
        },
        {
          "id": "e4_q52",
          "no": 52,
          "subject": "Matematik",
          "text": "Hipotenüsü 13 cm, bir dik kenarı 5 cm olan dik üçgenin diğer dik kenarı kaç cm'dir?",
          "options": [
            "A) 12",
            "B) 8",
            "C) 11",
            "D) 10",
            "E) 7"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. 5-12-13 özel dik üçgenidir; diğer kenar 12 cm'dir."
        },
        {
          "id": "e4_q53",
          "no": 53,
          "subject": "Matematik",
          "text": "Kenar uzunlukları 6 cm ve 8 cm olan bir dikdörtgenin köşegen uzunluğu kaç cm'dir?",
          "options": [
            "A) 14",
            "B) 12",
            "C) 9",
            "D) 15",
            "E) 10"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. 6-8-10 (3-4-5 üçgeninin 2 katı) dik üçgenidir; köşegen 10 cm'dir."
        },
        {
          "id": "e4_q54",
          "no": 54,
          "subject": "Matematik",
          "text": "Bir eşkenar üçgenin bir kenar uzunluğu 6 cm olduğuna göre çevresi kaç cm'dir?",
          "options": [
            "A) 12",
            "B) 36",
            "C) 30",
            "D) 24",
            "E) 18"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. Çevre = 3 · 6 = 18 cm."
        },
        {
          "id": "e4_q55",
          "no": 55,
          "subject": "Matematik",
          "text": "Alanı 81 cm² olan karenin çevresi kaç cm'dir?",
          "options": [
            "A) 32",
            "B) 48",
            "C) 40",
            "D) 27",
            "E) 36"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. Kenar a = √81 = 9 cm. Çevre = 4 · 9 = 36 cm."
        },
        {
          "id": "e4_q56",
          "no": 56,
          "subject": "Matematik",
          "text": "Düzgün bir altıgenin bir dış açısının ölçüsü kaç derecedir?",
          "options": [
            "A) 45°",
            "B) 60°",
            "C) 90°",
            "D) 72°",
            "E) 120°"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dir. Dış açı = 360° / 6 = 60°."
        },
        {
          "id": "e4_q57",
          "no": 57,
          "subject": "Matematik",
          "text": "İç açılarının toplamı 540° olan çokgen kaç kenarlıdır?",
          "options": [
            "A) 7",
            "B) 6",
            "C) 4",
            "D) 8",
            "E) 5 (Beşgen)"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. (n - 2) · 180° = 540° => n - 2 = 3 => n = 5."
        },
        {
          "id": "e4_q58",
          "no": 58,
          "subject": "Matematik",
          "text": "Yarıçapı 4 cm olan bir dairenin alanı kaç π cm²'dir?",
          "options": [
            "A) 16",
            "B) 12",
            "C) 8",
            "D) 20",
            "E) 24"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. Alan = π · r² = π · 4² = 16π."
        },
        {
          "id": "e4_q59",
          "no": 59,
          "subject": "Matematik",
          "text": "Taban uzunluğu 10 cm ve bu tabana ait yüksekliği 8 cm olan üçgenin alanı kaç cm²'dir?",
          "options": [
            "A) 80",
            "B) 60",
            "C) 50",
            "D) 30",
            "E) 40"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. Alan = (Taban · Yükseklik) / 2 = (10 · 8) / 2 = 40 cm²."
        },
        {
          "id": "e4_q60",
          "no": 60,
          "subject": "Matematik",
          "text": "Bir dik yamuğun paralel tabanları 6 cm ve 10 cm, yüksekliği 5 cm ise alanı kaç cm²'dir?",
          "options": [
            "A) 40",
            "B) 60",
            "C) 45",
            "D) 35",
            "E) 50"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. Alan = [(Alt Taban + Üst Taban) · Yükseklik] / 2 = [(10 + 6) · 5] / 2 = 40 cm²."
        },
        {
          "id": "e4_q61",
          "no": 61,
          "subject": "Tarih",
          "text": "İslamiyet öncesi Türk tarihinde hükümdarın Tanrı adına ülkeyi yönettiği inancına ne ad verilir?",
          "options": [
            "A) Kurultay",
            "B) Kut Anlayışı",
            "C) Töre",
            "D) Balbal",
            "E) İkili Teşkilat"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Yönetme yetkisinin Tanrı bağışı olduğuna inanılmasına Kut denir."
        },
        {
          "id": "e4_q62",
          "no": 62,
          "subject": "Tarih",
          "text": "Türk tarihinde matbaayı ve hareketli harf sistemini kullanan, yerleşik hayata geçen ilk Türk devleti hangisidir?",
          "options": [
            "A) Göktürkler",
            "B) Avarlar",
            "C) Hazarlar",
            "D) Uygurlar",
            "E) Kırgızlar"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Maniheizm etkisiyle yerleşik hayata geçen Uygurlar ilk Türk kütüphanelerini ve matbaasını kurmuştur."
        },
        {
          "id": "e4_q63",
          "no": 63,
          "subject": "Tarih",
          "text": "Orta Asya'da kurulan İLK Müslüman Türk devleti aşağıdakilerden hangisidir?",
          "options": [
            "A) Gazneliler",
            "B) Karahanlılar",
            "C) İhşidiler",
            "D) Tolunoğulları",
            "E) Büyük Selçuklular"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Satuk Buğra Han döneminde İslamiyet'i kabul eden Karahanlılar Orta Asya'daki ilk Türk-İslam devletidir."
        },
        {
          "id": "e4_q64",
          "no": 64,
          "subject": "Tarih",
          "text": "Hindistan'a 17 sefer düzenleyerek İslamiyet'in bu coğrafyada yayılmasını sağlayan Türk hükümdarı kimdir?",
          "options": [
            "A) Melikşah",
            "B) Tuğrul Bey",
            "C) Sultan Alparslan",
            "D) Gazneli Mahmut",
            "E) Babür Şah"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Gazneli Mahmut Hindistan seferleri ile 'Sultan' unvanını kullanan ilk Türk hükümdarıdır."
        },
        {
          "id": "e4_q65",
          "no": 65,
          "subject": "Tarih",
          "text": "Büyük Selçuklu Devleti ile Bizans İmparatorluğu arasında yapılan İLK büyük meydan savaşı hangisidir?",
          "options": [
            "A) Pasinler Savaşı (1048)",
            "B) Dandanakan Savaşı (1040)",
            "C) Malazgirt Savaşı (1071)",
            "D) Katvan Savaşı (1141)",
            "E) Miryokefalon Savaşı (1176)"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. 1048 Pasinler Savaşı Selçuklu ile Bizans arasındaki ilk resmi savaştır."
        },
        {
          "id": "e4_q66",
          "no": 66,
          "subject": "Tarih",
          "text": "Anadolu'nun kesin olarak Türk yurdu olduğunu tescilleyen ve Bizans'ın Türkleri Anadolu'dan atma ümidini tamamen yok eden zafer hangisidir?",
          "options": [
            "A) Pasinler Savaşı",
            "B) Yassıçemen Savaşı",
            "C) Kösedağ Savaşı",
            "D) Malazgirt Savaşı",
            "E) Miryokefalon Savaşı (1176)"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. II. Kılıç Arslan döneminde kazanılan 1176 Miryokefalon Zaferi ile Anadolu'nun tapusu alınmıştır."
        },
        {
          "id": "e4_q67",
          "no": 67,
          "subject": "Tarih",
          "text": "Osmanlı Devleti'ne barış yoluyla katılan ve böylece Osmanlı'nın ilk kez denizcilik faaliyetlerine başlamasını sağlayan beylik hangisidir?",
          "options": [
            "A) Candaroğulları",
            "B) Aydınoğulları",
            "C) Germiyanoğulları",
            "D) Karamanoğulları",
            "E) Karesioğulları"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. Orhan Bey döneminde Karesi Beyliği'nin katılmasıyla ilk Osmanlı donanması oluşmuştur."
        },
        {
          "id": "e4_q68",
          "no": 68,
          "subject": "Tarih",
          "text": "Osmanlı tarihinde ilk kez 'Rumeli Beylerbeyliği'ni kuran ve Sırpsındığı ile I. Kosova zaferlerini kazanan padişah kimdir?",
          "options": [
            "A) I. Murat (Hüdavendigar)",
            "B) Orhan Bey",
            "C) II. Murat",
            "D) Yıldırım Bayezid",
            "E) Osman Bey"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. I. Murat Rumeli Beylerbeyliği'ni kurmuş ve sınırları Balkanlara taşımıştır."
        },
        {
          "id": "e4_q69",
          "no": 69,
          "subject": "Tarih",
          "text": "1402 Ankara Savaşı'nda Yıldırım Bayezid'in Timur'a mağlup olmasıyla başlayan ve 11 yıl süren taht kavgaları dönemine ne ad verilir?",
          "options": [
            "A) Lale Devri",
            "B) Duraklama Devri",
            "C) Islahat Devri",
            "D) Tanzimat Devri",
            "E) Fetret Devri"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. Çelebi Mehmet Fetret Devri'ne son vererek Osmanlı'nın ikinci kurucusu kabul edilmiştir."
        },
        {
          "id": "e4_q70",
          "no": 70,
          "subject": "Tarih",
          "text": "İstanbul'un fethinin dünya tarihi açısından en önemli sonucu aşağıdakilerden hangisidir?",
          "options": [
            "A) Haçlı Seferleri'nin sona ermesi",
            "B) Osmanlı'nın sadece Asya'ya çekilmesi",
            "C) İpek Yolu'nun Afrika'ya taşınması",
            "D) Baharat Yolu'nun önemini tamamen kaybetmesi",
            "E) Orta Çağ'ın sona erip Yeni Çağ'ın başlaması ve surların topla yıkılabileceğinin anlaşılması"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. Fethin evrensel sonucu feodaliteyi sarsmış ve Orta Çağ'ı kapatıp Yeni Çağ'ı açmıştır."
        },
        {
          "id": "e4_q71",
          "no": 71,
          "subject": "Tarih",
          "text": "1517 Ridaniye Savaşı ile Memlük Devleti'ne son vererek Halifelik makamını Osmanlı hanedanına kazandıran padişah kimdir?",
          "options": [
            "A) II. Bayezid",
