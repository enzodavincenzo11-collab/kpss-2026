        },
        {
          "id": "e5_q108",
          "no": 108,
          "subject": "Vatandaşlık",
          "text": "Bir kimsenin ölüm tehlikesi içinde kaybolması halinde mahkemeden gaiplik kararı istenebilmesi için en az kaç yıl geçmesi gerekir?",
