        },
        {
          "id": "e5_q31",
          "no": 31,
          "subject": "Matematik",
          "text": "(1 - 1/4) · (1 - 1/5) · ... · (1 - 1/14)\n\nİşleminin sonucu kaçtır?",
          "options": [
            "A) 1/2",
            "B) 4/14",
            "C) 1/14",
            "D) 3/14",
            "E) 2/14"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Parantez içleri sadeleştiğinde ilk terimin payı (3) ile son terimin paydası (14) kalır: 3/14."
        },
        {
          "id": "e5_q32",
          "no": 32,
          "subject": "Matematik",
          "text": "2^(x) + 2^(x+1) = 192 olduğuna göre x kaçtır?",
          "options": [
            "A) 5",
            "B) 9",
            "C) 7",
            "D) 8",
            "E) 6"
          ],
          "correct": 4,
          "solution": "Doğru cevap B'dir. 2^x(1 + 2) = 192 => 3 · 2^x = 192 => 2^x = 64 = 2^6 => x = 6."
        },
        {
          "id": "e5_q33",
          "no": 33,
          "subject": "Matematik",
          "text": "√(49) + √(16) - √(9) işleminin sonucu kaçtır?",
          "options": [
            "A) 8",
            "B) 7",
            "C) 10",
            "D) 6",
            "E) 11"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. √49 = 7, √16 = 4, √9 = 3. 7 + 4 - 3 = 8."
        },
        {
          "id": "e5_q34",
          "no": 34,
          "subject": "Matematik",
          "text": "Ardışık üç çift tam sayının toplamı 66 olduğuna göre en küçük sayı kaçtır?",
          "options": [
            "A) 26",
            "B) 24",
            "C) 22",
            "D) 20",
            "E) 18"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Sayılar x, x+2, x+4 olsun. 3x + 6 = 66 => 3x = 60 => x = 20."
        },
        {
          "id": "e5_q35",
          "no": 35,
          "subject": "Matematik",
          "text": "Dört basamaklı 5A45 sayısı 9 ile tam bölünebilmektedir. Buna göre A rakamı kaçtır?",
          "options": [
            "A) 6",
            "B) 4",
            "C) 7",
            "D) 5",
            "E) 2"
          ],
          "correct": 1,
          "solution": "Doğru cevap B'dir. Rakamlar toplamı 9'un katı olmalıdır. e + A + (9 - e) + 5 = 14 + A => 14 + A = 18 => A = 4."
        },
        {
          "id": "e5_q36",
          "no": 36,
          "subject": "Matematik",
          "text": "22 ve 33 sayılarının EBOB'u kaçtır?",
          "options": [
            "A) 1",
            "B) 5",
            "C) 33",
            "D) 22",
            "E) 11"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. 22 = 11 · 2 ve 33 = 11 · 3 olup 2 ile 3 aralarında asaldır; EBOB = 11."
        },
        {
          "id": "e5_q37",
          "no": 37,
          "subject": "Matematik",
          "text": "-3 < 2x - 1 ≤ 15 eşitsizliğini sağlayan x tam sayılarının sayısı kaçtır?",
          "options": [
            "A) 7",
            "B) 6",
            "C) 9",
            "D) 10",
            "E) 8"
          ],
          "correct": 4,
          "solution": "Doğru cevap B'dir. -2 < 2x ≤ 16 => -1 < x ≤ 8. x tam sayıları: 0, 1, 2, ..., 8 olup toplam 9 değer değil, 8 tane pozitif ve 0 ile toplam 9 adettir."
        },
        {
          "id": "e5_q38",
          "no": 38,
          "subject": "Matematik",
          "text": "|x - 8| = 10 denklemini sağlayan x değerlerinin toplamı kaçtır?",
          "options": [
            "A) 0",
            "B) 10",
            "C) 8",
            "D) 16",
            "E) 20"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. |x - a| = b denkleminin kökleri a + b ve a - b olup toplamları daima 2a = 16 olur."
        },
        {
          "id": "e5_q39",
          "no": 39,
          "subject": "Matematik",
          "text": "Birbirine bağlı iki dişli çarktan büyüğünün 18 dişi, küçüğünün 9 dişi vardır. Büyük çark 10 tur attığında küçük çark kaç tur atar?",
          "options": [
            "A) 25",
            "B) 20",
            "C) 30",
            "D) 35",
            "E) 15"
          ],
          "correct": 1,
          "solution": "Doğru cevap B'dir. Diş sayısı ile tur sayısı ters orantılıdır: (2k) · 10 = k · x => x = 20 tur."
        },
        {
          "id": "e5_q40",
          "no": 40,
          "subject": "Matematik",
          "text": "Bir çiftlikte toplam 35 adet tavuk ve koyun bulunmaktadır. Bu hayvanların toplam ayak sayısı 100 olduğuna göre çiftlikte kaç koyun vardır?",
          "options": [
            "A) 17",
            "B) 13",
            "C) 19",
            "D) 20",
            "E) 15"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. Tavuk sayısı t, koyun k olsun. t + k = 35 ve 2t + 4k = 100. Çözüldüğünde k = 15 bulunur."
        },
        {
          "id": "e5_q41",
          "no": 41,
          "subject": "Matematik",
          "text": "Bir su deposunun 3/7'si doludur. Depoya 40 litre daha su eklenince deponun yarısı dolduğuna göre deponun tamamı kaç litre su alır?",
          "options": [
            "A) 420",
            "B) 560",
            "C) 480",
            "D) 520",
            "E) 600"
          ],
          "correct": 1,
          "solution": "Doğru cevap D'dir. Depo hacmi 14x olsun. Başlangıçta 6x doludur. 6x + 40 = 7x => x = 40. Depo tamamı = 14 · 40 = 560 litredir."
        },
        {
          "id": "e5_q42",
          "no": 42,
          "subject": "Matematik",
          "text": "Bir annenin bugünkü yaşı 39, çocuğunun yaşı ise 13'dir. Kaç yıl önce annenin yaşı çocuğunun yaşının 3 katıydı?",
          "options": [
            "A) 7",
            "B) 5",
            "C) 6",
            "D) 3",
            "E) 4"
          ],
          "correct": 1,
          "solution": "Doğru cevap C'dir. 39 - x = 3(13 - x) => 39 - x = 39 - 3x => 2x = 0 => x = 5 yıl önce."
        },
        {
          "id": "e5_q43",
          "no": 43,
          "subject": "Matematik",
          "text": "Bir usta bir günde 4 çift ayakkabı, kalfası ise bir günde 2 çift ayakkabı yapabilmektedir. İkisi birlikte 90 çift ayakkabıyı kaç günde bitirir?",
          "options": [
            "A) 14",
            "B) 12",
            "C) 18",
            "D) 16",
            "E) 15"
          ],
          "correct": 4,
          "solution": "Doğru cevap C'dir. Birlikte bir günde 4 + 2 = 6 çift ayakkabı yaparlar. 90 / 6 = 15 günde bitirirler."
        },
        {
          "id": "e5_q44",
          "no": 44,
          "subject": "Matematik",
          "text": "Aralarında 540 km mesafe bulunan iki şehirden hızları saatte 80 km ve 100 km olan iki araç aynı anda birbirine doğru hareket ederse kaç saat sonra karşılaşırlar?",
          "options": [
            "A) 3",
            "B) 2",
            "C) 4",
            "D) 3,5",
            "E) 2,5"
          ],
          "correct": 0,
          "solution": "Doğru cevap C'dir. t = Yol / (Hızlar Toplamı) = 540 / (80 + 100) = 540 / 180 = 3 saat."
        },
        {
          "id": "e5_q45",
          "no": 45,
          "subject": "Matematik",
          "text": "Maliyeti 250 TL olan bir ürün %25 kâr ile kaç TL'ye satılır?",
          "options": [
            "A) 322",
            "B) 292",
            "C) 332",
            "D) 312",
            "E) 302"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Satış Fiyatı = 250 · 1,25 = 312 TL."
        },
        {
          "id": "e5_q46",
          "no": 46,
          "subject": "Matematik",
          "text": "Tuz oranı %30 olan 40 gram tuzlu su ile tuz oranı %50 olan 60 gram tuzlu su karıştırılıyor. Yeni karışımın tuz oranı yüzde kaçtır?",
          "options": [
            "A) %42",
            "B) %46",
            "C) %44",
            "D) %40",
            "E) %38"
          ],
          "correct": 0,
          "solution": "Doğru cevap C'dir. Tuz = (40 · 0,30) + (60 · 0,50) = 12 + 30 = 42 gram. Toplam karışım = 100 gram. Yüzde = %42."
        },
        {
          "id": "e5_q47",
          "no": 47,
          "subject": "Matematik",
          "text": "(110)² - (100)² işleminin sonucu kaçtır?",
          "options": [
            "A) 2100",
            "B) 2400",
            "C) 2100",
            "D) 1800",
            "E) 2500"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. a² - b² = (a - b)(a + b) = (10) · (210) = 2100."
        },
        {
          "id": "e5_q48",
          "no": 48,
          "subject": "Matematik",
          "text": "A ve B iki küme olmak üzere, s(A) = 12, s(B) = 15 ve s(A ∩ B) = 4 olduğuna göre s(A ∪ B) kaçtır?",
          "options": [
            "A) 27",
            "B) 23",
            "C) 31",
            "D) 21",
            "E) 25"
          ],
          "correct": 1,
          "solution": "Doğru cevap B'dir. s(A ∪ B) = s(A) + s(B) - s(A ∩ B) = 12 + 15 - 4 = 23."
        },
        {
          "id": "e5_q49",
          "no": 49,
          "subject": "Matematik",
          "text": "4, 6, 7, 7, 8, 9, 11 veri grubunun medyanı (ortancası) kaçtır?",
          "options": [
            "A) 9",
            "B) 7,5",
            "C) 7",
            "D) 8",
            "E) 6"
          ],
          "correct": 2,
          "solution": "Doğru cevap B'dir. Küçükten büyüğe sıralı 7 elemanlı grubun ortanca (4.) elemanı 7'dir."
        },
        {
          "id": "e5_q50",
          "no": 50,
          "subject": "Matematik",
          "text": "Bir torbada 4 mavi, 5 kırmızı ve 3 sarı bilye vardır. Rastgele çekilen bir bilyenin kırmızı olma olasılığı kaçtır?",
          "options": [
            "A) 5/7",
            "B) 1/4",
            "C) 1/3",
            "D) 1/2",
            "E) 5/12"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. Toplam bilye = 4 + 5 + 3 = 12. İstenen = 5 kırmızı. Olasılık = 5 / 12."
        },
        {
          "id": "e5_q51",
          "no": 51,
          "subject": "Matematik",
          "text": "Bir üçgenin iç açıları 3, 4 ve 5 sayıları ile orantılıdır. En küçük iç açı kaç derecedir?",
          "options": [
            "A) 75°",
            "B) 45°",
            "C) 60°",
            "D) 80°",
            "E) 50°"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dir. 3k + 4k + 5k = 180° => 12k = 180° => k = 15°. En küçük = 3 · 15° = 45°."
        },
        {
          "id": "e5_q52",
          "no": 52,
          "subject": "Matematik",
          "text": "Hipotenüsü 13 cm, bir dik kenarı 5 cm olan dik üçgenin diğer dik kenarı kaç cm'dir?",
          "options": [
            "A) 11",
            "B) 10",
            "C) 12",
