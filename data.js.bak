        },
        {
          "id": "e3_q93",
          "no": 93,
          "subject": "Coğrafya",
          "text": "Eski akarsu vadilerinin deniz suları altında kalmasıyla oluşan 'Ria' kıyı tipine ülkemizde nerede rastlanır?",
