        },
        {
          "id": "e8_q98",
          "no": 98,
          "subject": "Coğrafya",
          "text": "Türkiye'de pamuk üretiminde GAP projesinin devreye girmesiyle İLK sıraya yerleşen ilimiz hangisidir?",
