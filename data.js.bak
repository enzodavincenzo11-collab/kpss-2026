          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. 5-12-13 özel dik üçgenidir; diğer kenar 12 cm'dir."
        },
        {
          "id": "e5_q53",
          "no": 53,
          "subject": "Matematik",
          "text": "Kenar uzunlukları 6 cm ve 8 cm olan bir dikdörtgenin köşegen uzunluğu kaç cm'dir?",
