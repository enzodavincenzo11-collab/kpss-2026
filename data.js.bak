          "correct": 2,
          "solution": "Doğru cevap A'dır. Van Gölü sodalı, Tuz Gölü tuzludur; Beyşehir Türkiye'nin en büyük tatlı su gölüdür."
        },
        {
          "id": "e4_q93",
          "no": 93,
          "subject": "Coğrafya",
          "text": "Eski akarsu vadilerinin deniz suları altında kalmasıyla oluşan 'Ria' kıyı tipine ülkemizde nerede rastlanır?",
          "options": [
            "A) Antalya Kaş kıyıları",
            "B) İzmir koyları",
            "C) Mersin sahili",
            "D) İstanbul ve Çanakkale Boğazları ile Haliç",
            "E) Trabzon sahili"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Boğazlar ve Haliç tipik Ria tipi kıyılardır."
        },
        {
          "id": "e4_q94",
          "no": 94,
          "subject": "Coğrafya",
          "text": "Kış mevsiminde Sibirya Yüksek Basıncı Türkiye'yi etkisi altına aldığında hava durumu nasıl seyreder?",
          "options": [
            "A) Sürekli sisli ve ılık",
            "B) Aşırı soğuk, ayaz ve kar yağışlı",
            "C) Ilık ve bol yağmurlu",
            "D) Fön rüzgarlı ve nemli",
            "E) Sıcak ve kurak"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Sibirya termik kökenli olduğu için kışın şiddetli ayaz ve dondurucu soğuk getirir."
        },
        {
          "id": "e4_q95",
          "no": 95,
          "subject": "Coğrafya",
          "text": "Karadeniz iklim bölgesinde en fazla yağış hangi mevsimde düşer?",
          "options": [
            "A) Sonbahar",
            "B) Ekinoks dönemi",
            "C) Kış",
            "D) İlkbahar",
            "E) Yaz"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. Karadeniz en çok yağışı sonbaharda, Akdeniz kışın, İç Anadolu ilkbaharda alır."
        },
        {
          "id": "e4_q96",
          "no": 96,
          "subject": "Coğrafya",
          "text": "Kırmızı renkli, demir oksit bakımından zengin 'Terra Rossa' toprakları en çok hangi coğrafi bölgemizde görülür?",
          "options": [
            "A) İç Anadolu",
            "B) Güneydoğu Anadolu",
            "C) Karadeniz Bölgesi",
            "D) Doğu Anadolu",
            "E) Akdeniz Bölgesi"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. Terra Rossa Akdeniz ikliminin kalkerli arazilerindeki karakteristik toprağıdır."
        },
        {
          "id": "e4_q97",
          "no": 97,
          "subject": "Coğrafya",
          "text": "Türkiye'de dağınık kır yerleşmelerinin en yaygın görüldüğü yer neresidir?",
          "options": [
            "A) Güneydoğu Anadolu",
            "B) Çukurova",
            "C) Doğu Karadeniz Bölümü",
            "D) Ergene Havzası",
            "E) Konya Ovası"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. Su bolluğu ve engebeli arazi nedeniyle evler birbirinden uzak kurulmuştur."
        },
        {
          "id": "e4_q98",
          "no": 98,
          "subject": "Coğrafya",
          "text": "Türkiye'de pamuk üretiminde GAP projesinin devreye girmesiyle İLK sıraya yerleşen ilimiz hangisidir?",
          "options": [
            "A) Aydın",
            "B) Diyarbakır",
            "C) Şanlıurfa",
            "D) Adana",
            "E) Hatay"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. Şanlıurfa Türkiye pamuk üretiminin yaklaşık yarısını tek başına karşılar."
        },
        {
          "id": "e4_q99",
          "no": 99,
          "subject": "Coğrafya",
          "text": "Maki ve çalı topluluklarının yapraklarını yemesiyle bilinen, ormanlara zarar verdiği için kıl keçisi yetiştiriciliği en çok nerede yapılır?",
          "options": [
            "A) Trakya",
            "B) Doğu Anadolu platoları",
            "C) Akdeniz (Toroslar kuşağı)",
            "D) Karadeniz sahili",
            "E) İç Anadolu"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. Kıl keçisi Akdeniz'in sarp ve engebeli dağlarına adapte olmuştur."
        },
        {
          "id": "e4_q100",
          "no": 100,
          "subject": "Coğrafya",
          "text": "Sivas Divriği ve Malatya Hekimhan yataklarından çıkarılan, Karabük ve İskenderun fabrikalarında işlenen maden hangisidir?",
          "options": [
            "A) Bakır",
            "B) Demir",
            "C) Krom",
            "D) Boksit",
            "E) Bor"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Türkiye'nin en zengin demir yatakları Divriği ve Hekimhan'dadır."
        },
        {
          "id": "e4_q101",
          "no": 101,
          "subject": "Coğrafya",
          "text": "Türkiye'nin ilk yerli petrol kuyusunun açıldığı ve rafinerisi bulunan ilimiz hangisidir?",
          "options": [
            "A) Siirt",
            "B) Diyarbakır",
            "C) Batman (Raman Dağı)",
            "D) Adıyaman",
            "E) Mardin"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. 1940'ta Raman dağında petrol bulunmuş, Batman Rafinerisi kurulmuştur."
        },
        {
          "id": "e4_q102",
          "no": 102,
          "subject": "Coğrafya",
          "text": "Karabük ve Ereğli'de demir-çelik fabrikalarının kurulmasında etkili olan temel faktör nedir?",
          "options": [
            "A) Taş kömürü enerji kaynağına yakınlık",
            "B) İş gücünün ucuz olması",
            "C) Tüketici pazarına yakınlık",
            "D) Demir madeni yataklarına yakınlık",
            "E) İklim koşulları"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. Fabrikalar demir cevherine değil, onu eritecek yüksek kalorili taş kömürüne yakın kurulmuştur."
        },
        {
          "id": "e4_q103",
          "no": 103,
          "subject": "Coğrafya",
          "text": "Güneydoğu Anadolu Projesi (GAP) kapsamında inşa edilen Türkiye'nin en büyük gövde hacmine sahip barajı hangisidir?",
          "options": [
            "A) Deriner Barajı",
            "B) Atatürk Barajı",
            "C) Karakaya Barajı",
            "D) Keban Barajı",
            "E) Ilısu Barajı"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Fırat nehri üzerindeki Atatürk Barajı en büyük hidroelektrik santralimizdir."
        },
        {
          "id": "e4_q104",
          "no": 104,
          "subject": "Coğrafya",
          "text": "UNESCO listesinde yer alan Pamukkale Travertenleri hangi ilimizde yer alan karstik bir doğa harikasıdır?",
          "options": [
            "A) Aydın",
            "B) Uşak",
            "C) Muğla",
            "D) Afyonkarahisar",
            "E) Denizli"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. Kalsiyum karbonat birikimiyle oluşan Pamukkale Denizli ilimizdedir."
        },
        {
          "id": "e4_q105",
          "no": 105,
          "subject": "Coğrafya",
          "text": "İç Anadolu Bölgesi'nde ilkbaharda ısınan havanın yükselerek öğleden sonra oluşturduğu sağanak yağışlara ne ad verilir?",
          "options": [
            "A) Cephe Yağışları (Frontal)",
            "B) Yamaç Yağışları (Orografik)",
            "C) Muson Yağışları",
            "D) Kırkikindi Yağışları (Konveksiyonel)",
            "E) Kasırga"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Isınan havanın yükselmesiyle oluşan konveksiyonel yağışlara halk arasında Kırkikindi denir."
        },
        {
          "id": "e4_q106",
          "no": 106,
          "subject": "Vatandaşlık",
          "text": "Bir hukuk kuralına aykırı davranılması halinde devlet gücüyle uygulanan yaptırımlardan 'iptal' kararı hangi işlem türüne uygulanır?",
          "options": [
            "A) Haksız fiillere",
            "B) Suç teşkil eden fiillere",
            "C) Hukuka aykırı idari işlemlere",
            "D) Boşanma davalarına",
            "E) Borcunu ödemeyen şahıslara"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. İdari işlemlerin hukuka aykırılığı halinde idare mahkemeleri iptal kararı verir."
        },
        {
          "id": "e4_q107",
          "no": 107,
          "subject": "Vatandaşlık",
          "text": "Hakların KAZANILMASINDA geçerli olan temel medeni hukuk ilkesi hangisidir?",
          "options": [
            "A) Dürüstlük Kuralı (Objektif İyiniyet)",
            "B) Kanunilik",
            "C) Ahde Vefa",
            "D) İyiniyet (Subjektif İyiniyet)",
            "E) Kusursuz Sorumluluk"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Hakların kazanılmasında iyiniyet, kullanılmasında ve borçların ifasında ise dürüstlük kuralı geçerlidir."
        },
        {
          "id": "e4_q108",
          "no": 108,
          "subject": "Vatandaşlık",
          "text": "Bir kimsenin ölüm tehlikesi içinde kaybolması halinde mahkemeden gaiplik kararı istenebilmesi için en az kaç yıl geçmesi gerekir?",
          "options": [
            "A) 5 yıl",
            "B) 15 yıl",
            "C) 3 yıl",
            "D) 1 yıl",
            "E) 10 yıl"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Ölüm tehlikesi içinde kaybolmada 1 yıl; uzun süre haber alınamama durumunda ise 5 yıl sonra gaiplik istenebilir."
        },
        {
          "id": "e4_q109",
          "no": 109,
          "subject": "Vatandaşlık",
          "text": "1982 Anayasası'na göre Türkiye Devleti'nin yönetim şekli aşağıdakilerden hangisidir?",
          "options": [
            "A) Oligarşi",
            "B) Cumhuriyet",
            "C) Federasyon",
            "D) Meşruti Monarşi",
            "E) Teokrasi"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Anayasa Madde 1: 'Türkiye Devleti bir Cumhuriyettir.'"
        },
        {
          "id": "e4_q110",
          "no": 110,
          "subject": "Vatandaşlık",
          "text": "Aşağıdakilerden hangisi 1982 Anayasası'nda yer alan 'Sosyal ve Ekonomik Haklar' (İsteme Hakları) arasında yer alır?",
          "options": [
            "A) Yaşama Hakkı",
            "B) Kişi Hürriyeti ve Güvenliği",
            "C) Eğitim ve Öğrenim Hakkı",
            "D) Dilekçe Hakkı",
            "E) Seçme ve Seçilme Hakkı"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. Eğitim, sağlık, çalışma ve konut hakkı devlette edim isteyen sosyal-ekonomik haklardır."
        },
        {
          "id": "e4_q111",
          "no": 111,
          "subject": "Vatandaşlık",
          "text": "Türkiye Büyük Millet Meclisi genel seçimleri kural olarak kaç yılda bir Cumhurbaşkanı seçimiyle birlikte yapılır?",
          "options": [
            "A) 5 yıl",
            "B) 4 yıl",
            "C) 3 yıl",
            "D) 6 yıl",
            "E) 7 yıl"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. 2017 anayasa değişikliği ile TBMM ve Cumhurbaşkanlığı seçimleri 5 yılda bir aynı gün yapılır."
        },
        {
          "id": "e4_q112",
          "no": 112,
          "subject": "Vatandaşlık",
          "text": "Bir milletvekilinin istifa etmesi durumunda milletvekilliğinin düşmesine kim karar verir?",
          "options": [
            "A) Cumhurbaşkanı",
            "B) TBMM Başkanı",
            "C) TBMM Genel Kurulu",
            "D) Anayasa Mahkemesi",
            "E) Yüksek Seçim Kurulu"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. İstifa eden milletvekilinin üyeliği TBMM Başkanlık Divanı tespitinden sonra TBMM Genel Kurulu kararıyla düşer."
        },
        {
          "id": "e4_q113",
          "no": 113,
          "subject": "Vatandaşlık",
          "text": "TBMM'nin bir kanun teklifini kabul edebilmesi için toplantıya katılanların salt çoğunluğu aranır; ancak bu karar yeter sayısı hiçbir şekilde hangisinden az olamaz?",
          "options": [
            "A) 200 milletvekilinden",
            "B) 400 milletvekilinden",
            "C) 300 milletvekilinden",
            "D) 184 milletvekilinden",
            "E) Üye tamsayısının dörtte birinin bir fazlasından (151)"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. Karar yeter sayısı üye tamsayısının (600) 1/4'ünün 1 fazlası olan 151'den az olamaz."
        },
        {
          "id": "e4_q114",
          "no": 114,
          "subject": "Vatandaşlık",
          "text": "Cumhurbaşkanı yardımcıları ve bakanları atama ve görevlerine son verme yetkisi kime aittir?",
          "options": [
            "A) TBMM Genel Kurulu'na",
            "B) TBMM Başkanı'na",
            "C) Anayasa Mahkemesi'ne",
            "D) Danıştay'a",
            "E) Cumhurbaşkanına"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. Bakanlar ve yardımcılar doğrudan Cumhurbaşkanı tarafından atanır ve görevden alınır."
        },
        {
          "id": "e4_q115",
          "no": 115,
          "subject": "Vatandaşlık",
          "text": "Cumhurbaşkanlığı Kararnameleri ile aşağıdakilerden hangisi DÜZENLENEMEZ?",
          "options": [
            "A) Devlet Denetleme Kurulu'nun işleyişi",
            "B) Bakanlıkların kurulması ve kaldırılması",
            "C) Milli Güvenlik Kurulu Genel Sekreterliği teşkilatı",
            "D) Anayasa'da yer alan Temel Haklar ve Kişi Hakları",
            "E) Üst kademe kamu yöneticilerinin atanması"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Kişisel haklar ve siyasi haklar CBK ile düzenlenemez; sadece kanunla düzenlenebilir."
        },
        {
          "id": "e4_q116",
          "no": 116,
          "subject": "Vatandaşlık",
          "text": "Anayasa Mahkemesi'ne kanunların şekil ve esas bakımından Anayasa'ya aykırılığı iddiasıyla doğrudan iptal davası (Soyut Norm Denetimi) açma süresi Resmi Gazete'de yayımlanmasından itibaren kaç gündür?",
          "options": [
            "A) 90 gün",
            "B) 45 gün",
            "C) 60 gün",
            "D) 120 gün",
            "E) 30 gün"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. İptal davası açma süresi Resmi Gazete'de yayımlandığı tarihten itibaren 60 gündür."
        },
        {
          "id": "e4_q117",
          "no": 117,
          "subject": "Vatandaşlık",
          "text": "Adli yargı kolunun en yüksek temyiz inceleme mercii olan yüksek mahkeme hangisidir?",
          "options": [
            "A) Anayasa Mahkemesi",
            "B) Uyuşmazlık Mahkemesi",
            "C) Sayıştay",
            "D) Yargıtay",
            "E) Danıştay"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Hukuk ve ceza mahkemelerinden verilen kararların son inceleme mercii Yargıtay'dır."
        },
        {
          "id": "e4_q118",
          "no": 118,
          "subject": "Vatandaşlık",
          "text": "İdare hukukunda merkezi yönetimin taşra teşkilatında 'İl Genel İdaresi'nin başında kim bulunur?",
          "options": [
            "A) Kaymakam",
            "B) İl Genel Meclisi Başkanı",
            "C) Vali",
            "D) Defterdar",
            "E) Belediye Başkanı"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. İl genel idaresinin başı ve devletin ildeki temsilcisi Vali'dir."
        },
        {
          "id": "e4_q119",
          "no": 119,
          "subject": "Vatandaşlık",
          "text": "657 Sayılı Devlet Memurları Kanunu'na göre memura 'görevinde ve davranışlarında daha dikkatli olması gerektiğinin yazı ile bildirilmesi' hangi disiplin cezasıdır?",
          "options": [
            "A) İhtar",
            "B) Kademe durdurma",
            "C) Kınama",
            "D) Aylıktan kesme",
            "E) Uyarma"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. 'Daha dikkatli olması gerektiğinin yazı ile bildirilmesi' Uyarma cezasının yasal tanımıdır."
        },
        {
          "id": "e4_q120",
          "no": 120,
          "subject": "Vatandaşlık",
          "text": "Türkiye Cumhuriyeti'nin 1952 yılında üye olduğu Kuzey Atlantik Antlaşması Örgütü (NATO) askeri ittifakının genel merkezi nerededir?",
          "options": [
            "A) Brüksel (Belçika)",
            "B) Paris (Fransa)",
            "C) Londra (İngiltere)",
            "D) Cenevre (İsviçre)",
            "E) Washington (ABD)"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. NATO'nun siyasi ve askeri genel karargahı Belçika'nın başkenti Brüksel'dedir."
        }
      ]
    },
    {
      "id": "deneme_5",
      "title": "5. Deneme (KPSS 2026 Tam Format - 120 Özgün Soru)",
      "questions": [
        {
          "id": "e5_q1",
          "no": 1,
          "subject": "Türkçe",
          "text": "\"Müfettiş hesapları incelerken adeta <u>kılı kırk yarıyordu</u>.\"\n\nBu cümledeki altı çizili deyimin cümleye kattığı anlam aşağıdakilerden hangisidir?",
          "options": [
            "A) Aşırı titiz ve ayrıntılı davranmak",
            "B) Aceleyle karar vermek",
            "C) Beklenmedik bir engelle karşılaşmak",
            "D) Başkalarının fikrine saygı duymak",
            "E) Kendi çıkarlarını ön planda tutmak"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. 'kılı kırk yarmak' deyimi Türkçede 'aşırı titiz ve ayrıntılı davranmak' anlamında kullanılır."
        },
        {
          "id": "e5_q2",
          "no": 2,
          "subject": "Türkçe",
          "text": "Yeni açılan tesisteki görevliler, dünkü toplantıda <u>birçok</u> (I) konuyu ele aldı. Projenin <u>traş</u> (II) aşamasında bazı aksaklıklar yaşansa da ekip <u>özveriyle</u> (III) çalışarak <u>her şeyi</u> (IV) zamanında <u>teslim etti</u> (V).\n\nBu parçada numaralanmış altı çizili sözlerden hangisinin yazımı YANLIŞTIR?",
          "options": [
            "A) V",
            "B) II",
            "C) IV",
            "D) I",
            "E) III"
          ],
          "correct": 1,
          "solution": "Doğru cevap B'dir. 'traş' sözcüğünün TDK kılavuzundaki doğru yazımı 'tıraş' şeklindedir."
        },
        {
          "id": "e5_q3",
          "no": 3,
          "subject": "Türkçe",
          "text": "Eski bir İstanbul konağının bahçesi ( ) asırlık çınarlar ( ) hanımelleri ve ıhlamur kokuları ( ) Burası insanın tüm yorgunluğunu unutturan bir sığınaktı ( )\n\nBu parçada parantezle belirtilen yerlere sırasıyla hangi noktalama işaretleri getirilmelidir?",
          "options": [
            "A) (:) (,) (...) (.)",
            "B) (;) (,) (,) (.)",
            "C) (,) (,) (.) (...)",
            "D) (:) (;) (...) (!)",
            "E) (,) (;) (.) (!)"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. Bahçede bulunanlar açıklandığı için iki nokta (:), eş görevli ögeler arasına virgül (,), yüklemi olmayan eksiltili cümle sonuna üç nokta (...), tamamlanmış cümle sonuna nokta (.) konur."
        },
        {
          "id": "e5_q4",
          "no": 4,
          "subject": "Türkçe",
          "text": "\"Son yıllarda dijital mecraların yaygınlaşmasıyla birlikte geleneksel dergicilik eski ilgisini kaybetti.\"\n\nBu cümlenin anlam özelliği aşağıdakilerden hangisidir?",
          "options": [
            "A) Karşılaştırılan iki durum arasında çelişki kurmaktadır.",
            "B) Neden-Sonuç ilişkisi içermektedir.",
            "C) Kanıtlanamaz bir varsayım bildirmektedir.",
            "D) Doğrudan bir tanım cümlesidir.",
            "E) Bir ön yargı ve kesin yargı bildirmektedir."
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Verilen cümlede eylemin gerekçesi ve yönelimi Neden-Sonuç çerçevesinde kurulmuştur."
        },
        {
          "id": "e5_q5",
          "no": 5,
          "subject": "Türkçe",
          "text": "Mimari, bir toplumun sadece taşa ve betona verdiği biçim değil; o toplumun hayatı, insanı ve doğayı nasıl algıladığının açık bir aynasıdır. Geniş avlulu, cumbalı geleneksel evlerimize baktığımızda mahremiyet ile komşuluk sıcaklığının nasıl kusursuzca kaynaştığını görürüz.\n\nBu parçada asıl anlatılmak istenen aşağıdakilerden hangisidir?",
          "options": [
            "A) Bireysel yeteneklerin ancak sıkı bir disiplinle açığa çıkabileceği.",
            "B) Teknolojik imkânların geleneksel değerleri tehdit ettiği.",
