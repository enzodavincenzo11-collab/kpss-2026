        {
          "id": "e5_q77",
          "no": 77,
          "subject": "Tarih",
          "text": "1826 yılında Yeniçeri Ocağı'nın kaldırılarak yerine Asakir-i Mansure-i Muhammediye ordusunun kurulması olayına tarihte ne ad verilir?",
          "options": [
            "A) Çınar Vakası",
            "B) Vaka-i Hayriye",
            "C) Babıali Baskını",
            "D) Vaka-i Vakvakiye",
            "E) Kuleli Vakası"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. 'Hayırlı Olay' anlamına gelen Vaka-i Hayriye ile padişah merkezi otoritesini pekiştirmiştir."
        },
        {
          "id": "e5_q78",
          "no": 78,
          "subject": "Tarih",
          "text": "1856 Islahat Fermanı'nın Tanzimat Fermanı'ndan en temel farkı aşağıdakilerden hangisidir?",
          "options": [
            "A) Yeni bir ordu kurması",
            "B) Kadınlara seçme hakkı vermesi",
            "C) Özellikle gayrimüslim azınlıklara geniş ayrıcalıklar tanıması ve küçük düşürücü sözleri yasaklaması",
            "D) Padişahı tahttan indirmesi",
            "E) İlk kez matbaayı getirmesi"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. Islahat Fermanı Avrupalı devletlerin baskısıyla azınlık haklarına odaklanmıştır."
        },
        {
          "id": "e5_q79",
          "no": 79,
          "subject": "Tarih",
          "text": "I. Dünya Savaşı'nda Osmanlı Devleti'nin zafer kazandığı ve savaşın en az iki yıl uzamasına yol açan TEK taarruz değil savunma cephesi hangisidir?",
          "options": [
            "A) Kanal Cephesi",
            "B) Hicaz-Yemen Cephesi",
            "C) Irak Cephesi",
            "D) Kafkas Cephesi",
            "E) Çanakkale Cephesi"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. 18 Mart 1915 Çanakkale Deniz Zaferi ve kara savaşları İtilaf güçlerini püskürtmüştür."
        },
        {
          "id": "e5_q80",
          "no": 80,
          "subject": "Tarih",
          "text": "Milli Mücadele aleyhine çalışan ve Adana çevresinde bir Ermeni devleti kurmayı amaçlayan zararlı cemiyet hangisidir?",
          "options": [
            "A) Mavri Mira",
            "B) Teali İslam",
            "C) Pontus Rum",
            "D) İngiliz Muhipleri",
            "E) Hınçak ve Taşnak"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. Hınçak ve Taşnak cemiyetleri Doğu Anadolu ve Çukurova'da terör eylemleri yapmıştır."
        },
        {
          "id": "e5_q81",
          "no": 81,
          "subject": "Tarih",
          "text": "\"Milli sınırlar içinde vatan bir bütündür, bölünemez.\" kararı İLK KEZ nerede alınmıştır?",
          "options": [
            "A) Erzurum Kongresi",
            "B) Sivas Kongresi",
            "C) Havza Genelgesi",
            "D) Amasya Genelgesi",
            "E) Misak-ı Milli"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. Erzurum Kongresi'nin 1. maddesi Misak-ı Milli sınırlarının temelini atmıştır."
        },
        {
          "id": "e5_q82",
          "no": 82,
          "subject": "Tarih",
          "text": "Son Osmanlı Mebusan Meclisi'nde 28 Ocak 1920'de kabul edilen ve milli mücadelenin barış şartlarını belirleyen belge hangisidir?",
          "options": [
            "A) Teşkilat-ı Esasiye",
            "B) Misak-ı Milli (Milli Ant)",
            "C) Amasya Protokolü",
            "D) Mudanya Mütarekesi",
            "E) Sevr Taslağı"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Misak-ı Milli kapitülasyonların reddini ve vatanın bölünmezliğini dünyaya duyurmuştur."
        },
        {
          "id": "e5_q83",
          "no": 83,
          "subject": "Tarih",
          "text": "I. İnönü Zaferi'nden sonra Sovyet Rusya ile TBMM arasında imzalanan ve büyük bir Avrupa devletinin TBMM'yi ilk kez tanıdığı antlaşma hangisidir?",
          "options": [
            "A) Ankara Antlaşması",
            "B) Mudanya Mütarekesi",
            "C) Moskova Antlaşması (1921)",
            "D) Gümrü Antlaşması",
            "E) Kars Antlaşması"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. 16 Mart 1921 Moskova Antlaşması ile Sovyet Rusya Misak-ı Milli'yi resmen tanımıştır."
        },
        {
          "id": "e5_q84",
          "no": 84,
          "subject": "Tarih",
          "text": "Kurtuluş Savaşı'nda Doğu Trakya, İstanbul ve Boğazlar hangi diplomatik belge ile SAVAŞ YAPILMADAN teslim alınmıştır?",
          "options": [
            "A) Ankara Antlaşması",
            "B) Gümrü Antlaşması",
            "C) Lozan Antlaşması",
            "D) Mudanya Ateşkes Antlaşması",
            "E) Montrö Sözleşmesi"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. İsmet Paşa'nın imzaladığı Mudanya Mütarekesi ile savaşsız diplomatik zafer kazanılmıştır."
        },
        {
          "id": "e5_q85",
          "no": 85,
          "subject": "Tarih",
          "text": "24 Temmuz 1923 Lozan Barış Antlaşması'nda çözülemeyerek Türkiye ile İngiltere arasında ikili görüşmelere bırakılan konu hangisidir?",
          "options": [
            "A) Boğazlar",
            "B) Musul Meselesi (Irak Sınırı)",
            "C) Kapitülasyonlar",
            "D) Azınlıklar",
            "E) Dış Borçlar"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Musul sorunu Lozan'da çözülememiş, 1926 Ankara Antlaşması'na bırakılmıştır."
        },
        {
          "id": "e5_q86",
          "no": 86,
          "subject": "Tarih",
          "text": "Özel sektörün yetersiz kaldığı büyük sanayi yatırımlarının ve fabrikaların devlet eliyle kurulmasını öngören Atatürk ilkesi hangisidir?",
          "options": [
            "A) Milliyetçilik",
            "B) Halkçılık",
            "C) Devletçilik",
            "D) Cumhuriyetçilik",
            "E) Laiklik"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. Sümerbank, Etibank ve şeker/dokuma fabrikaları devletçilik ilkesiyle inşa edilmiştir."
        },
        {
          "id": "e5_q87",
          "no": 87,
          "subject": "Tarih",
          "text": "1936 yılında imzalanarak Boğazlar Komisyonu'nu kaldıran ve Boğazlarda tam Türk egemenliğini sağlayan sözleşme hangisidir?",
          "options": [
            "A) Montrö Boğazlar Sözleşmesi",
            "B) Bağdat Paktı",
            "C) Sadabat Paktı",
            "D) Balkan Antantı",
            "E) Lozan Sözleşmesi"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. Montrö Sözleşmesi ile Boğazlar askersizleştirilmekten çıkarılmış, Türk askeri yerleşmiştir."
        },
        {
          "id": "e5_q88",
          "no": 88,
          "subject": "Coğrafya",
          "text": "Türkiye'de 21 Haziran tarihinde en uzun gündüz hangi ilimizde yaşanır?",
          "options": [
            "A) Iğdır",
            "B) Hatay",
            "C) Sinop",
            "D) Çanakkale",
            "E) Antalya"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. 21 Haziran'da kuzeye gidildikçe gündüz süresi uzar; Türkiye'nin en kuzeyindeki Sinop'ta gündüz en uzundur."
        },
        {
          "id": "e5_q89",
          "no": 89,
          "subject": "Coğrafya",
          "text": "Aşağıdaki dağlardan hangisi oluşum yönüyle 'volkanik' kökenli bir dağdır?",
          "options": [
            "A) Kaz Dağı",
            "B) Madra Dağı",
            "C) Nemrut Dağı (Bitlis)",
            "D) Ilgaz Dağı",
            "E) Kaçkar Dağı"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. Nemrut, Süphan, Tendürek ve Ağrı volkanik dağlardır."
        },
        {
          "id": "e5_q90",
          "no": 90,
          "subject": "Coğrafya",
          "text": "Teke ve Taşeli platolarında nüfusun seyrek olmasının temel coğrafi nedeni nedir?",
          "options": [
            "A) Tarım alanlarının çok geniş olması",
            "B) Karstik arazi yapısı ve engebeli yeryüzü şekilleri",
            "C) Sanayinin çok gelişmiş olması",
            "D) Aşırı soğuk karasal iklim",
            "E) Yer altı sularının çok yüzeyde olması"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Kireç taşı (karstik) suyu tabana sızdırdığından toprak kuraktır ve engebelidir."
        },
        {
          "id": "e5_q91",
          "no": 91,
          "subject": "Coğrafya",
          "text": "Kızılırmak nehrinin Karadeniz'e döküldüğü yerde oluşturduğu delta ovası hangisidir?",
          "options": [
            "A) Çarşamba Ovası",
            "B) Silifke Ovası",
            "C) Balat Ovası",
            "D) Bafra Ovası",
            "E) Çukurova"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Kızılırmak Bafra Ovası'nı, Yeşilırmak ise Çarşamba Ovası'nı oluşturur."
        },
        {
          "id": "e5_q92",
          "no": 92,
          "subject": "Coğrafya",
          "text": "Türkiye'nin en büyük tatlı su gölü aşağıdakilerden hangisidir?",
          "options": [
            "A) Tuz Gölü",
            "B) Eğirdir Gölü",
            "C) İznik Gölü",
            "D) Beyşehir Gölü",
            "E) Van Gölü"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Van Gölü sodalı, Tuz Gölü tuzludur; Beyşehir Türkiye'nin en büyük tatlı su gölüdür."
        },
        {
          "id": "e5_q93",
          "no": 93,
          "subject": "Coğrafya",
          "text": "Eski akarsu vadilerinin deniz suları altında kalmasıyla oluşan 'Ria' kıyı tipine ülkemizde nerede rastlanır?",
          "options": [
            "A) İzmir koyları",
