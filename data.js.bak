          "no": 110,
          "subject": "Vatandaşlık",
          "text": "Aşağıdakilerden hangisi 1982 Anayasası'nda yer alan 'Sosyal ve Ekonomik Haklar' (İsteme Hakları) arasında yer alır?",
          "options": [
            "A) Dilekçe Hakkı",
            "B) Eğitim ve Öğrenim Hakkı",
            "C) Seçme ve Seçilme Hakkı",
            "D) Kişi Hürriyeti ve Güvenliği",
            "E) Yaşama Hakkı"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Eğitim, sağlık, çalışma ve konut hakkı devlette edim isteyen sosyal-ekonomik haklardır."
        },
        {
          "id": "e7_q111",
          "no": 111,
          "subject": "Vatandaşlık",
          "text": "Türkiye Büyük Millet Meclisi genel seçimleri kural olarak kaç yılda bir Cumhurbaşkanı seçimiyle birlikte yapılır?",
          "options": [
            "A) 4 yıl",
            "B) 7 yıl",
            "C) 5 yıl",
            "D) 3 yıl",
            "E) 6 yıl"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. 2017 anayasa değişikliği ile TBMM ve Cumhurbaşkanlığı seçimleri 5 yılda bir aynı gün yapılır."
        },
        {
          "id": "e7_q112",
          "no": 112,
          "subject": "Vatandaşlık",
          "text": "Bir milletvekilinin istifa etmesi durumunda milletvekilliğinin düşmesine kim karar verir?",
          "options": [
            "A) TBMM Başkanı",
            "B) TBMM Genel Kurulu",
            "C) Anayasa Mahkemesi",
            "D) Cumhurbaşkanı",
            "E) Yüksek Seçim Kurulu"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. İstifa eden milletvekilinin üyeliği TBMM Başkanlık Divanı tespitinden sonra TBMM Genel Kurulu kararıyla düşer."
        },
        {
          "id": "e7_q113",
          "no": 113,
          "subject": "Vatandaşlık",
          "text": "TBMM'nin bir kanun teklifini kabul edebilmesi için toplantıya katılanların salt çoğunluğu aranır; ancak bu karar yeter sayısı hiçbir şekilde hangisinden az olamaz?",
          "options": [
            "A) 300 milletvekilinden",
            "B) Üye tamsayısının dörtte birinin bir fazlasından (151)",
            "C) 400 milletvekilinden",
            "D) 184 milletvekilinden",
            "E) 200 milletvekilinden"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Karar yeter sayısı üye tamsayısının (600) 1/4'ünün 1 fazlası olan 151'den az olamaz."
        },
        {
          "id": "e7_q114",
          "no": 114,
          "subject": "Vatandaşlık",
          "text": "Cumhurbaşkanı yardımcıları ve bakanları atama ve görevlerine son verme yetkisi kime aittir?",
          "options": [
            "A) TBMM Başkanı'na",
            "B) Danıştay'a",
            "C) Cumhurbaşkanına",
            "D) Anayasa Mahkemesi'ne",
            "E) TBMM Genel Kurulu'na"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. Bakanlar ve yardımcılar doğrudan Cumhurbaşkanı tarafından atanır ve görevden alınır."
        },
        {
          "id": "e7_q115",
          "no": 115,
          "subject": "Vatandaşlık",
          "text": "Cumhurbaşkanlığı Kararnameleri ile aşağıdakilerden hangisi DÜZENLENEMEZ?",
          "options": [
            "A) Milli Güvenlik Kurulu Genel Sekreterliği teşkilatı",
            "B) Bakanlıkların kurulması ve kaldırılması",
            "C) Devlet Denetleme Kurulu'nun işleyişi",
            "D) Anayasa'da yer alan Temel Haklar ve Kişi Hakları",
            "E) Üst kademe kamu yöneticilerinin atanması"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Kişisel haklar ve siyasi haklar CBK ile düzenlenemez; sadece kanunla düzenlenebilir."
        },
        {
          "id": "e7_q116",
          "no": 116,
          "subject": "Vatandaşlık",
          "text": "Anayasa Mahkemesi'ne kanunların şekil ve esas bakımından Anayasa'ya aykırılığı iddiasıyla doğrudan iptal davası (Soyut Norm Denetimi) açma süresi Resmi Gazete'de yayımlanmasından itibaren kaç gündür?",
          "options": [
            "A) 120 gün",
            "B) 60 gün",
            "C) 45 gün",
            "D) 90 gün",
            "E) 30 gün"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. İptal davası açma süresi Resmi Gazete'de yayımlandığı tarihten itibaren 60 gündür."
        },
        {
          "id": "e7_q117",
          "no": 117,
          "subject": "Vatandaşlık",
          "text": "Adli yargı kolunun en yüksek temyiz inceleme mercii olan yüksek mahkeme hangisidir?",
          "options": [
            "A) Danıştay",
            "B) Sayıştay",
            "C) Anayasa Mahkemesi",
            "D) Uyuşmazlık Mahkemesi",
            "E) Yargıtay"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. Hukuk ve ceza mahkemelerinden verilen kararların son inceleme mercii Yargıtay'dır."
        },
        {
          "id": "e7_q118",
          "no": 118,
          "subject": "Vatandaşlık",
          "text": "İdare hukukunda merkezi yönetimin taşra teşkilatında 'İl Genel İdaresi'nin başında kim bulunur?",
          "options": [
            "A) Kaymakam",
            "B) İl Genel Meclisi Başkanı",
            "C) Defterdar",
            "D) Vali",
            "E) Belediye Başkanı"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. İl genel idaresinin başı ve devletin ildeki temsilcisi Vali'dir."
        },
        {
          "id": "e7_q119",
          "no": 119,
          "subject": "Vatandaşlık",
          "text": "657 Sayılı Devlet Memurları Kanunu'na göre memura 'görevinde ve davranışlarında daha dikkatli olması gerektiğinin yazı ile bildirilmesi' hangi disiplin cezasıdır?",
          "options": [
            "A) Kınama",
            "B) Kademe durdurma",
            "C) Uyarma",
            "D) İhtar",
            "E) Aylıktan kesme"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. 'Daha dikkatli olması gerektiğinin yazı ile bildirilmesi' Uyarma cezasının yasal tanımıdır."
        },
        {
          "id": "e7_q120",
          "no": 120,
          "subject": "Vatandaşlık",
          "text": "Türkiye Cumhuriyeti'nin 1952 yılında üye olduğu Kuzey Atlantik Antlaşması Örgütü (NATO) askeri ittifakının genel merkezi nerededir?",
          "options": [
            "A) Londra (İngiltere)",
            "B) Cenevre (İsviçre)",
            "C) Paris (Fransa)",
            "D) Brüksel (Belçika)",
            "E) Washington (ABD)"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. NATO'nun siyasi ve askeri genel karargahı Belçika'nın başkenti Brüksel'dedir."
        }
      ]
    },
    {
      "id": "deneme_8",
      "title": "8. Deneme (KPSS 2026 Tam Format - 120 Özgün Soru)",
      "questions": [
        {
          "id": "e8_q1",
          "no": 1,
          "subject": "Türkçe",
          "text": "\"Öğrenciler hocanın anlattığı tarihi anektodları <u>can kulağıyla dinledi</u>.\"\n\nBu cümledeki altı çizili deyimin cümleye kattığı anlam aşağıdakilerden hangisidir?",
          "options": [
            "A) Beklenmedik bir engelle karşılaşmak",
            "B) Aceleyle karar vermek",
            "C) Büyük bir dikkatle dinlemek",
            "D) Başkalarının fikrine saygı duymak",
            "E) Kendi çıkarlarını ön planda tutmak"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. 'can kulağıyla dinlemek' deyimi Türkçede 'büyük bir dikkatle dinlemek' anlamında kullanılır."
        },
        {
          "id": "e8_q2",
          "no": 2,
          "subject": "Türkçe",
          "text": "Yeni açılan tesisteki görevliler, dünkü toplantıda <u>birçok</u> (I) konuyu ele aldı. Projenin <u>şarz</u> (II) aşamasında bazı aksaklıklar yaşansa da ekip <u>özveriyle</u> (III) çalışarak <u>her şeyi</u> (IV) zamanında <u>teslim etti</u> (V).\n\nBu parçada numaralanmış altı çizili sözlerden hangisinin yazımı YANLIŞTIR?",
          "options": [
            "A) I",
            "B) III",
            "C) IV",
            "D) II",
            "E) V"
          ],
          "correct": 3,
          "solution": "Doğru cevap B'dir. 'şarz' sözcüğünün TDK kılavuzundaki doğru yazımı 'şarj' şeklindedir."
        },
        {
          "id": "e8_q3",
          "no": 3,
          "subject": "Türkçe",
          "text": "Eski bir İstanbul konağının bahçesi ( ) asırlık çınarlar ( ) hanımelleri ve ıhlamur kokuları ( ) Burası insanın tüm yorgunluğunu unutturan bir sığınaktı ( )\n\nBu parçada parantezle belirtilen yerlere sırasıyla hangi noktalama işaretleri getirilmelidir?",
          "options": [
            "A) (:) (,) (...) (.)",
            "B) (;) (,) (,) (.)",
            "C) (,) (,) (.) (...)",
            "D) (:) (;) (...) (!)",
            "E) (,) (;) (.) (!)"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. Bahçede bulunanlar açıklandığı için iki nokta (:), eş görevli ögeler arasına virgül (,), yüklemi olmayan eksiltili cümle sonuna üç nokta (...), tamamlanmış cümle sonuna nokta (.) konur."
        },
        {
          "id": "e8_q4",
          "no": 4,
          "subject": "Türkçe",
          "text": "\"Tarihi köprü, sel sularının ayaklarını aşındırması yüzünden geçici olarak trafiğe kapatıldı.\"\n\nBu cümlenin anlam özelliği aşağıdakilerden hangisidir?",
          "options": [
            "A) Doğrudan bir tanım cümlesidir.",
            "B) Bir ön yargı ve kesin yargı bildirmektedir.",
            "C) Neden-Sonuç ilişkisi içermektedir.",
            "D) Kanıtlanamaz bir varsayım bildirmektedir.",
            "E) Karşılaştırılan iki durum arasında çelişki kurmaktadır."
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. Verilen cümlede eylemin gerekçesi ve yönelimi Neden-Sonuç çerçevesinde kurulmuştur."
        },
        {
          "id": "e8_q5",
          "no": 5,
          "subject": "Türkçe",
          "text": "Bilim ile sanat, insan aklının ve ruhunun aynı hedefe yönelmiş iki farklı kanadıdır. Biri gerçeği deney ve formüllerle ararken diğeri aynı gerçeği sezgi ve estetikle yakalamaya çalışır. Kanatlardan birini ihmal eden medeniyetler asla yükselemez.\n\nBu parçada asıl anlatılmak istenen aşağıdakilerden hangisidir?",
          "options": [
            "A) Medeniyetlerin ilerleyişinde bilim ve sanatın birbirini tamamlayan iki temel güç olduğu.",
            "B) Toplumsal kuralların bireyin özgürlüğünü kısıtladığı.",
            "C) Bireysel yeteneklerin ancak sıkı bir disiplinle açığa çıkabileceği.",
            "D) Teknolojik imkânların geleneksel değerleri tehdit ettiği.",
            "E) Sanatçıların ekonomik kaygılarla hareket etmemesi gerektiği."
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. Paragrafın bütününde ana fikir olarak 'Medeniyetlerin ilerleyişinde bilim ve sanatın birbirini tamamlayan iki temel güç olduğu' savunulmaktadır."
        },
        {
          "id": "e8_q6",
          "no": 6,
          "subject": "Türkçe",
          "text": "Ses Bilgisi (Ünsüz Düşmesi): 'Küçücük' sözcüğünde hangi ses olayı gerçekleşmiştir?",
          "options": [
            "A) Benzeşme",
            "B) Ünsüz türemesi",
            "C) Ünlü düşmesi",
            "D) Kaynaşma",
            "E) Ünsüz düşmesi"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. Küçük-cük birleşirken k ünsüzü düşmüştür."
        },
        {
          "id": "e8_q7",
          "no": 7,
          "subject": "Türkçe",
          "text": "Ses Bilgisi (Ünsüz Yumuşaması): Aşağıdaki sözcüklerin hangisinde ünsüz yumuşaması kuralına aykırılık vardır?",
          "options": [
            "A) Ağacın dalı",
            "B) Kitabın kapağı",
            "C) Kalbin sesi",
            "D) Hukukun üstünlüğü",
            "E) Yurdun dört yanı"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dir. Yabancı kökenli 'hukuk' sözcüğü ünlüyle başlayan ek aldığında 'hukuğun' olmaz, k sert kalır."
        },
        {
          "id": "e8_q8",
          "no": 8,
          "subject": "Türkçe",
          "text": "Cümle Ögeleri: \"Güneş batarken sahil boyunca yürüyen yaşlı adam, eski günleri tebessümle andı.\" cümlesinde yüklemden önceki bölüm hangi ögedir?",
          "options": [
            "A) Dolaylı Tümleç",
            "B) Belirtili Nesne",
            "C) Özne",
            "D) Zarf Tümleci",
            "E) Edat Tümleci"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dir. 'Neyi andı?' -> 'eski günleri' (Belirtili Nesne)."
        },
        {
          "id": "e8_q9",
          "no": 9,
          "subject": "Türkçe",
          "text": "Sözcük Türü (Sıfat): Aşağıdaki cümlelerin hangisinde 'güzel' sözcüğü niteleme sıfatı olarak kullanılmıştır?",
          "options": [
            "A) Şiiri çok güzel okudu.",
            "B) Güzelin kahrı çekilmez.",
            "C) Güzel bir ev satın aldılar.",
            "D) Güzel konuştuğu için herkes dinledi.",
            "E) Bugün hava ne güzel."
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. 'Güzel ev' tamlamasında 'güzel' ismi niteleyen sıfattır."
        },
        {
          "id": "e8_q10",
          "no": 10,
          "subject": "Türkçe",
          "text": "Sözcük Türü (Zarf): Aşağıdaki cümlelerin hangisinde zaman zarfı kullanılmıştır?",
          "options": [
            "A) Aşağı indi.",
            "B) Çok çalışarak başardı.",
            "C) Yavaşça kapıyı kapattı.",
            "D) Yarın sabah erkenden yola çıkacağız.",
            "E) Koşarak içeri girdi."
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dir. 'Yarın sabah' eylemin zamanını bildirir."
        },
        {
          "id": "e8_q11",
          "no": 11,
          "subject": "Türkçe",
          "text": "Sözcük Türü (Zamir): Aşağıdaki cümlelerin hangisinde belgisiz zamir kullanılmıştır?",
          "options": [
            "A) Hangi soruyu çözemedin?",
            "B) Sen buraya gel.",
            "C) Birkaçı sınava zamanında yetişemedi.",
            "D) Bu kitabı dün aldım.",
            "E) Kendi kendine konuşuyordu."
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. 'Birkaçı' ismin yerini belirsiz şekilde tuttuğundan belgisiz zamirdir."
        },
        {
          "id": "e8_q12",
          "no": 12,
          "subject": "Türkçe",
          "text": "Fiil Çatısı (Geçişli): Aşağıdaki fiillerden hangisi nesne alabilen (geçişli) bir fiildir?",
          "options": [
            "A) Gülmek",
            "B) Kaçmak",
            "C) Dinlemek",
            "D) Ağlamak",
            "E) Uyumak"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. 'Onu dinlemek' denir; geçişlidir."
        },
        {
          "id": "e8_q13",
          "no": 13,
          "subject": "Türkçe",
          "text": "Fiil Çatısı (Edilgen): Aşağıdaki cümlelerin hangisinin yüklemi edilgen çatılıdır?",
          "options": [
            "A) Ali sabah erkenden yıkandı.",
            "B) Kuşlar gökyüzünde uçuştu.",
            "C) Çocuk annesini görünce sevindi.",
            "D) Yaşlı adam pencereden etrafa bakındı.",
            "E) Sınıf bayram için özenle süslendi."
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. Süsleme işini yapan belirsizdir, süslendi edilgendir."
        },
        {
          "id": "e8_q14",
          "no": 14,
          "subject": "Türkçe",
          "text": "Cümle Türleri (Birleşik): Aşağıdaki cümlelerin hangisi yapısına göre 'girişik birleşik' cümledir?",
          "options": [
            "A) Kapıyı açtı ve içeri girdi.",
            "B) Bugün hava çok sıcak.",
            "C) Yağmur yağınca herkes saçak altlarına kaçıştı.",
            "D) Ankara'ya yarın gidecek.",
            "E) Bize geldi ama fazla kalmadı."
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. İçinde fiilimsi ('yağınca') bulunan tek yüklemli cümle girişik birleşiktir."
        },
        {
          "id": "e8_q15",
          "no": 15,
          "subject": "Türkçe",
          "text": "Anlatım Bozukluğu: \"Hiçbir çalışan patronun sözünü dinlemiyor, kendi bildiğini yapıyordu.\" cümlesindeki anlatım bozukluğunun nedeni nedir?",
          "options": [
            "A) Yüklem uyuşmazlığı",
            "B) Yanlış edat kullanımı",
            "C) Sözcüğün yanlış yerde kullanımı",
            "D) Nesne eksikliği",
            "E) İkinci cümlede özne eksikliği (hepsi yapıyordu)"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. 'Hiçbiri' olumsuz özne olduğu için olumlu 'yapıyordu' yüklemine bağlanamaz; 'hepsi kendi bildiğini yapıyordu' denmelidir."
        },
        {
          "id": "e8_q16",
          "no": 16,
          "subject": "Türkçe",
          "text": "Paragraf (Akışı Bozan): (I) Bozkırda bahar kısa ama görkemlidir. (II) Karlar erir erimez her yer rengarenk çiçeklerle donanır. (III) Tarım arazilerinin sulanması için baraj inşaatları sürdürülmektedir. (IV) Ancak yazın sıcağı bastırınca bu cümbüş yerini sarı bir sessizliğe bırakır. (V) Doğa bir sonraki bahara kadar uykuya çekilir.\n\nAkışı bozan cümle hangisidir?",
          "options": [
            "A) IV",
            "B) III",
            "C) I",
            "D) II",
            "E) V"
          ],
          "correct": 1,
          "solution": "Doğru cevap C'dir. III. cümle doğa anlatımı arasına giren alakasız bir ekonomik faaliyettir."
        },
        {
          "id": "e8_q17",
          "no": 17,
          "subject": "Türkçe",
          "text": "Paragraf (İkiye Bölme): Bir metinde yeni bir düşünce veya konunun farklı bir boyutuna geçilen cümle paragrafı ikiye böler. Bu kurala göre metin mantıksal olarak nereden ayrılmalıdır?",
          "options": [
            "A) İlk cümleden",
            "B) Soru cümlesinden",
            "C) En son cümleden",
            "D) Konunun yön değiştirdiği cümleden",
            "E) En kısa cümleden"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dir. Paragraf bölme sorularında konu/bakış açısı değişikliği esastır."
        },
        {
          "id": "e8_q18",
          "no": 18,
          "subject": "Türkçe",
          "text": "Yazım Kuralı (Tarihler): Aşağıdakilerin hangisinde belirli bir tarih bildiren gün ve ay adlarının yazımı DOĞRUDUR?",
          "options": [
            "A) 29 ekim 1923",
            "B) geçen pazartesi günü",
            "C) 1995 yılı haziranında",
            "D) eylül ayında",
            "E) 29 Ekim 1923 Pazartesi"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. Belirli gün ve ay adları (rakamla belirtilen) büyük harfle başlar."
        },
        {
          "id": "e8_q19",
          "no": 19,
          "subject": "Türkçe",
          "text": "Yazım Kuralı (Bileşik Fiiller): Aşağıdaki cümlelerin hangisinde 'etmek/olmak' ile kurulan bileşik fiilin yazımı YANLIŞTIR?",
          "options": [
            "A) Yapılan yardımı <u>kabul etti</u>.",
            "B) Haberi duyunca <u>kahır oldu</u>.",
            "C) Bu durum beni çok <u>rahatsız etti</u>.",
            "D) Durumu hemen <u>fark etti</u>.",
            "E) Bütün borçlarını <u>terk etti</u>."
          ],
          "correct": 1,
          "solution": "Doğru cevap C'dir. Ses düşmesi olduğu için 'kahroldu' bitişik yazılmalıdır ('kahır oldu' yanlıştır)."
        },
        {
          "id": "e8_q20",
          "no": 20,
          "subject": "Türkçe",
          "text": "Söz Sanatları (Benzetme): \"Gözleri bir çift kömür gibi parlıyordu.\" cümlesinde hangi söz sanatı vardır?",
          "options": [
            "A) Tezat",
            "B) Teşhis",
            "C) Teşbih (Benzetme)",
            "D) Mecaz-ı Mürsel",
            "E) İstiare"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. 'Gibi' edatıyla kömüre benzetme yapılmıştır."
        },
        {
          "id": "e8_q21",
          "no": 21,
          "subject": "Türkçe",
          "text": "Söz Sanatları (Kişileştirme): \"Rüzgâr dağların ardından usulca fısıldadı.\" cümlesindeki söz sanatı nedir?",
          "options": [
            "A) Tariz",
            "B) Teşhis (Kişileştirme)",
            "C) Telmih",
            "D) Tenasüp",
            "E) Mübalağa"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dir. İnsana ait fısıldama özelliği rüzgâra verilmiştir."
        },
        {
          "id": "e8_q22",
          "no": 22,
          "subject": "Türkçe",
          "text": "Anlatım İlkeleri (Duruluk): Bir cümlede gereksiz sözcük kullanılmaması hangi anlatım ilkesidir?",
          "options": [
            "A) Açıklık",
            "B) Doğallık",
            "C) Özgünlük",
            "D) Akıcılık",
            "E) Duruluk"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. Gereksiz sözcükten arınmışlık 'duruluk'tur."
        },
        {
          "id": "e8_q23",
          "no": 23,
          "subject": "Türkçe",
          "text": "Anlatım İlkeleri (Açıklık): Cümlenin tek bir anlama gelmesi ve çok anlamlılık taşımaması hangi ilkedir?",
          "options": [
            "A) Özlülük",
            "B) Açıklık",
            "C) Yalınlık",
            "D) Akıcılık",
