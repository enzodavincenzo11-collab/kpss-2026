        },
        {
          "id": "e3_q31",
          "no": 31,
          "subject": "Matematik",
          "text": "(1 - 1/2) · (1 - 1/3) · ... · (1 - 1/12)\n\nİşleminin sonucu kaçtır?",
          "options": [
            "A) 1/12",
            "B) 2/12",
            "C) 1/12",
            "D) 1/2",
            "E) 2/12"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. Parantez içleri sadeleştiğinde ilk terimin payı (1) ile son terimin paydası (12) kalır: 1/12."
        },
        {
          "id": "e3_q32",
          "no": 32,
          "subject": "Matematik",
          "text": "2^(x) + 2^(x+1) = 48 olduğuna göre x kaçtır?",
          "options": [
            "A) 5",
            "B) 3",
            "C) 6",
            "D) 7",
            "E) 4"
          ],
          "correct": 4,
          "solution": "Doğru cevap B'dir. 2^x(1 + 2) = 48 => 3 · 2^x = 48 => 2^x = 16 = 2^4 => x = 4."
        },
        {
          "id": "e3_q33",
          "no": 33,
          "subject": "Matematik",
          "text": "√(25) + √(16) - √(9) işleminin sonucu kaçtır?",
          "options": [
            "A) 5",
            "B) 6",
            "C) 4",
            "D) 8",
            "E) 9"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. √25 = 5, √16 = 4, √9 = 3. 5 + 4 - 3 = 6."
        },
        {
          "id": "e3_q34",
          "no": 34,
          "subject": "Matematik",
          "text": "Ardışık üç çift tam sayının toplamı 54 olduğuna göre en küçük sayı kaçtır?",
          "options": [
            "A) 14",
            "B) 16",
            "C) 18",
            "D) 20",
            "E) 22"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Sayılar x, x+2, x+4 olsun. 3x + 6 = 54 => 3x = 48 => x = 16."
        },
        {
          "id": "e3_q35",
          "no": 35,
          "subject": "Matematik",
          "text": "Dört basamaklı 3A65 sayısı 9 ile tam bölünebilmektedir. Buna göre A rakamı kaçtır?",
          "options": [
            "A) 6",
            "B) 2",
            "C) 4",
            "D) 5",
            "E) 7"
          ],
          "correct": 2,
          "solution": "Doğru cevap B'dir. Rakamlar toplamı 9'un katı olmalıdır. e + A + (9 - e) + 5 = 14 + A => 14 + A = 18 => A = 4."
        },
        {
          "id": "e3_q36",
          "no": 36,
          "subject": "Matematik",
          "text": "18 ve 27 sayılarının EBOB'u kaçtır?",
          "options": [
            "A) 18",
            "B) 27",
            "C) 1",
            "D) 9",
            "E) 4"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. 18 = 9 · 2 ve 27 = 9 · 3 olup 2 ile 3 aralarında asaldır; EBOB = 9."
        },
        {
          "id": "e3_q37",
          "no": 37,
          "subject": "Matematik",
          "text": "-3 < 2x - 1 ≤ 11 eşitsizliğini sağlayan x tam sayılarının sayısı kaçtır?",
          "options": [
            "A) 6",
            "B) 5",
            "C) 4",
            "D) 7",
            "E) 8"
          ],
          "correct": 0,
          "solution": "Doğru cevap B'dir. -2 < 2x ≤ 12 => -1 < x ≤ 6. x tam sayıları: 0, 1, 2, ..., 6 olup toplam 7 değer değil, 6 tane pozitif ve 0 ile toplam 7 adettir."
        },
        {
          "id": "e3_q38",
          "no": 38,
          "subject": "Matematik",
          "text": "|x - 6| = 8 denklemini sağlayan x değerlerinin toplamı kaçtır?",
          "options": [
            "A) 16",
            "B) 0",
            "C) 8",
            "D) 12",
            "E) 6"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. |x - a| = b denkleminin kökleri a + b ve a - b olup toplamları daima 2a = 12 olur."
        },
        {
          "id": "e3_q39",
          "no": 39,
          "subject": "Matematik",
          "text": "Birbirine bağlı iki dişli çarktan büyüğünün 14 dişi, küçüğünün 7 dişi vardır. Büyük çark 10 tur attığında küçük çark kaç tur atar?",
          "options": [
            "A) 35",
            "B) 30",
            "C) 25",
            "D) 20",
            "E) 15"
          ],
          "correct": 3,
          "solution": "Doğru cevap B'dir. Diş sayısı ile tur sayısı ters orantılıdır: (2k) · 10 = k · x => x = 20 tur."
        },
        {
          "id": "e3_q40",
          "no": 40,
          "subject": "Matematik",
          "text": "Bir çiftlikte toplam 31 adet tavuk ve koyun bulunmaktadır. Bu hayvanların toplam ayak sayısı 88 olduğuna göre çiftlikte kaç koyun vardır?",
          "options": [
            "A) 18",
            "B) 15",
            "C) 13",
            "D) 11",
            "E) 17"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. Tavuk sayısı t, koyun k olsun. t + k = 31 ve 2t + 4k = 88. Çözüldüğünde k = 13 bulunur."
        },
        {
          "id": "e3_q41",
          "no": 41,
          "subject": "Matematik",
          "text": "Bir su deposunun 3/7'si doludur. Depoya 40 litre daha su eklenince deponun yarısı dolduğuna göre deponun tamamı kaç litre su alır?",
          "options": [
            "A) 520",
            "B) 560",
            "C) 480",
            "D) 600",
            "E) 420"
          ],
          "correct": 1,
          "solution": "Doğru cevap D'dir. Depo hacmi 14x olsun. Başlangıçta 6x doludur. 6x + 40 = 7x => x = 40. Depo tamamı = 14 · 40 = 560 litredir."
        },
        {
          "id": "e3_q42",
          "no": 42,
          "subject": "Matematik",
          "text": "Bir annenin bugünkü yaşı 37, çocuğunun yaşı ise 11'dir. Kaç yıl önce annenin yaşı çocuğunun yaşının 3 katıydı?",
          "options": [
            "A) 3",
            "B) 5",
            "C) 7",
            "D) 4",
            "E) 6"
          ],
          "correct": 1,
          "solution": "Doğru cevap C'dir. 37 - x = 3(11 - x) => 37 - x = 33 - 3x => 2x = -4 => x = 5 yıl önce."
        },
        {
          "id": "e3_q43",
          "no": 43,
          "subject": "Matematik",
          "text": "Bir usta bir günde 4 çift ayakkabı, kalfası ise bir günde 2 çift ayakkabı yapabilmektedir. İkisi birlikte 90 çift ayakkabıyı kaç günde bitirir?",
          "options": [
            "A) 15",
            "B) 12",
            "C) 14",
            "D) 16",
            "E) 18"
          ],
          "correct": 0,
          "solution": "Doğru cevap C'dir. Birlikte bir günde 4 + 2 = 6 çift ayakkabı yaparlar. 90 / 6 = 15 günde bitirirler."
        },
        {
          "id": "e3_q44",
          "no": 44,
          "subject": "Matematik",
          "text": "Aralarında 516 km mesafe bulunan iki şehirden hızları saatte 76 km ve 96 km olan iki araç aynı anda birbirine doğru hareket ederse kaç saat sonra karşılaşırlar?",
          "options": [
            "A) 2",
            "B) 3",
            "C) 4",
            "D) 2,5",
            "E) 3,5"
          ],
          "correct": 1,
          "solution": "Doğru cevap C'dir. t = Yol / (Hızlar Toplamı) = 516 / (76 + 96) = 516 / 172 = 3 saat."
        },
        {
          "id": "e3_q45",
          "no": 45,
          "subject": "Matematik",
          "text": "Maliyeti 230 TL olan bir ürün %25 kâr ile kaç TL'ye satılır?",
          "options": [
            "A) 307",
            "B) 287",
            "C) 267",
            "D) 277",
            "E) 297"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Satış Fiyatı = 230 · 1,25 = 287 TL."
        },
        {
          "id": "e3_q46",
          "no": 46,
          "subject": "Matematik",
          "text": "Tuz oranı %30 olan 40 gram tuzlu su ile tuz oranı %50 olan 60 gram tuzlu su karıştırılıyor. Yeni karışımın tuz oranı yüzde kaçtır?",
          "options": [
            "A) %40",
            "B) %44",
            "C) %46",
            "D) %42",
            "E) %38"
          ],
          "correct": 3,
          "solution": "Doğru cevap C'dir. Tuz = (40 · 0,30) + (60 · 0,50) = 12 + 30 = 42 gram. Toplam karışım = 100 gram. Yüzde = %42."
        },
        {
          "id": "e3_q47",
          "no": 47,
          "subject": "Matematik",
          "text": "(108)² - (98)² işleminin sonucu kaçtır?",
          "options": [
            "A) 2500",
            "B) 2060",
            "C) 1800",
            "D) 2400",
            "E) 2100"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. a² - b² = (a - b)(a + b) = (10) · (206) = 2060."
        },
        {
          "id": "e3_q48",
          "no": 48,
          "subject": "Matematik",
          "text": "A ve B iki küme olmak üzere, s(A) = 12, s(B) = 15 ve s(A ∩ B) = 4 olduğuna göre s(A ∪ B) kaçtır?",
          "options": [
            "A) 25",
            "B) 21",
            "C) 27",
            "D) 31",
            "E) 23"
          ],
          "correct": 4,
          "solution": "Doğru cevap B'dir. s(A ∪ B) = s(A) + s(B) - s(A ∩ B) = 12 + 15 - 4 = 23."
        },
        {
          "id": "e3_q49",
          "no": 49,
          "subject": "Matematik",
          "text": "4, 6, 7, 7, 8, 9, 11 veri grubunun medyanı (ortancası) kaçtır?",
          "options": [
            "A) 7",
            "B) 6",
            "C) 7,5",
            "D) 8",
            "E) 9"
          ],
          "correct": 0,
          "solution": "Doğru cevap B'dir. Küçükten büyüğe sıralı 7 elemanlı grubun ortanca (4.) elemanı 7'dir."
        },
        {
          "id": "e3_q50",
          "no": 50,
          "subject": "Matematik",
          "text": "Bir torbada 4 mavi, 5 kırmızı ve 3 sarı bilye vardır. Rastgele çekilen bir bilyenin kırmızı olma olasılığı kaçtır?",
          "options": [
            "A) 5/12",
            "B) 1/3",
            "C) 5/7",
            "D) 1/4",
            "E) 1/2"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. Toplam bilye = 4 + 5 + 3 = 12. İstenen = 5 kırmızı. Olasılık = 5 / 12."
        },
        {
          "id": "e3_q51",
          "no": 51,
          "subject": "Matematik",
          "text": "Bir üçgenin iç açıları 3, 4 ve 5 sayıları ile orantılıdır. En küçük iç açı kaç derecedir?",
          "options": [
            "A) 50°",
            "B) 75°",
            "C) 60°",
            "D) 45°",
            "E) 80°"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dir. 3k + 4k + 5k = 180° => 12k = 180° => k = 15°. En küçük = 3 · 15° = 45°."
        },
        {
          "id": "e3_q52",
          "no": 52,
          "subject": "Matematik",
          "text": "Hipotenüsü 13 cm, bir dik kenarı 5 cm olan dik üçgenin diğer dik kenarı kaç cm'dir?",
          "options": [
            "A) 8",
            "B) 11",
            "C) 7",
            "D) 10",
            "E) 12"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. 5-12-13 özel dik üçgenidir; diğer kenar 12 cm'dir."
        },
        {
          "id": "e3_q53",
          "no": 53,
          "subject": "Matematik",
          "text": "Kenar uzunlukları 6 cm ve 8 cm olan bir dikdörtgenin köşegen uzunluğu kaç cm'dir?",
          "options": [
            "A) 14",
            "B) 10",
            "C) 9",
            "D) 12",
            "E) 15"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dir. 6-8-10 (3-4-5 üçgeninin 2 katı) dik üçgenidir; köşegen 10 cm'dir."
        },
        {
          "id": "e3_q54",
          "no": 54,
          "subject": "Matematik",
          "text": "Bir eşkenar üçgenin bir kenar uzunluğu 6 cm olduğuna göre çevresi kaç cm'dir?",
          "options": [
            "A) 12",
            "B) 30",
            "C) 24",
            "D) 36",
            "E) 18"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. Çevre = 3 · 6 = 18 cm."
        },
        {
          "id": "e3_q55",
          "no": 55,
          "subject": "Matematik",
          "text": "Alanı 81 cm² olan karenin çevresi kaç cm'dir?",
