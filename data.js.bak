        {
          "id": "e3_q100",
          "no": 100,
          "subject": "Coğrafya",
          "text": "Sivas Divriği ve Malatya Hekimhan yataklarından çıkarılan, Karabük ve İskenderun fabrikalarında işlenen maden hangisidir?",
