      {
        "id": "e1_q55",
        "subject": "Matematik",
        "number": 55,
        "text": "55. A ve B iki küme olmak üzere,\n<code>s(A) = 13</code>, <code>s(B) = 11</code> ve <code>s(A ∩ B) = 4</code>\nolduğuna göre <code>s(A ∪ B)</code> kaçtır?",
        "options": [
          "A) 18",
          "B) 20",
          "C) 22",
          "D) 24",
          "E) 26"
        ],
        "correct": 1,
        "solution": "s(A ∪ B) = s(A) + s(B) - s(A ∩ B) = 13 + 11 - 4 = 20."
      },
