          "no": 109,
          "subject": "Vatandaşlık",
          "text": "1982 Anayasası'na göre Türkiye Devleti'nin yönetim şekli aşağıdakilerden hangisidir?",
          "options": [
            "A) Oligarşi",
            "B) Cumhuriyet",
            "C) Federasyon",
            "D) Teokrasi",
            "E) Meşruti Monarşi"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Anayasa Madde 1: 'Türkiye Devleti bir Cumhuriyettir.'"
        },
        {
          "id": "e9_q110",
          "no": 110,
          "subject": "Vatandaşlık",
          "text": "Aşağıdakilerden hangisi 1982 Anayasası'nda yer alan 'Sosyal ve Ekonomik Haklar' (İsteme Hakları) arasında yer alır?",
          "options": [
            "A) Yaşama Hakkı",
            "B) Kişi Hürriyeti ve Güvenliği",
            "C) Seçme ve Seçilme Hakkı",
            "D) Eğitim ve Öğrenim Hakkı",
            "E) Dilekçe Hakkı"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Eğitim, sağlık, çalışma ve konut hakkı devlette edim isteyen sosyal-ekonomik haklardır."
        },
        {
          "id": "e9_q111",
          "no": 111,
          "subject": "Vatandaşlık",
          "text": "Türkiye Büyük Millet Meclisi genel seçimleri kural olarak kaç yılda bir Cumhurbaşkanı seçimiyle birlikte yapılır?",
          "options": [
            "A) 3 yıl",
            "B) 5 yıl",
            "C) 4 yıl",
            "D) 6 yıl",
            "E) 7 yıl"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. 2017 anayasa değişikliği ile TBMM ve Cumhurbaşkanlığı seçimleri 5 yılda bir aynı gün yapılır."
        },
        {
          "id": "e9_q112",
          "no": 112,
          "subject": "Vatandaşlık",
          "text": "Bir milletvekilinin istifa etmesi durumunda milletvekilliğinin düşmesine kim karar verir?",
          "options": [
            "A) Yüksek Seçim Kurulu",
            "B) Anayasa Mahkemesi",
            "C) TBMM Genel Kurulu",
            "D) Cumhurbaşkanı",
            "E) TBMM Başkanı"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. İstifa eden milletvekilinin üyeliği TBMM Başkanlık Divanı tespitinden sonra TBMM Genel Kurulu kararıyla düşer."
        },
        {
          "id": "e9_q113",
          "no": 113,
          "subject": "Vatandaşlık",
          "text": "TBMM'nin bir kanun teklifini kabul edebilmesi için toplantıya katılanların salt çoğunluğu aranır; ancak bu karar yeter sayısı hiçbir şekilde hangisinden az olamaz?",
          "options": [
            "A) 184 milletvekilinden",
            "B) 300 milletvekilinden",
            "C) Üye tamsayısının dörtte birinin bir fazlasından (151)",
            "D) 200 milletvekilinden",
            "E) 400 milletvekilinden"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. Karar yeter sayısı üye tamsayısının (600) 1/4'ünün 1 fazlası olan 151'den az olamaz."
        },
        {
          "id": "e9_q114",
          "no": 114,
          "subject": "Vatandaşlık",
          "text": "Cumhurbaşkanı yardımcıları ve bakanları atama ve görevlerine son verme yetkisi kime aittir?",
          "options": [
            "A) Cumhurbaşkanına",
            "B) TBMM Genel Kurulu'na",
            "C) Anayasa Mahkemesi'ne",
            "D) TBMM Başkanı'na",
            "E) Danıştay'a"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. Bakanlar ve yardımcılar doğrudan Cumhurbaşkanı tarafından atanır ve görevden alınır."
        },
        {
          "id": "e9_q115",
          "no": 115,
          "subject": "Vatandaşlık",
          "text": "Cumhurbaşkanlığı Kararnameleri ile aşağıdakilerden hangisi DÜZENLENEMEZ?",
          "options": [
            "A) Devlet Denetleme Kurulu'nun işleyişi",
            "B) Milli Güvenlik Kurulu Genel Sekreterliği teşkilatı",
            "C) Bakanlıkların kurulması ve kaldırılması",
            "D) Üst kademe kamu yöneticilerinin atanması",
            "E) Anayasa'da yer alan Temel Haklar ve Kişi Hakları"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. Kişisel haklar ve siyasi haklar CBK ile düzenlenemez; sadece kanunla düzenlenebilir."
        },
        {
          "id": "e9_q116",
          "no": 116,
          "subject": "Vatandaşlık",
          "text": "Anayasa Mahkemesi'ne kanunların şekil ve esas bakımından Anayasa'ya aykırılığı iddiasıyla doğrudan iptal davası (Soyut Norm Denetimi) açma süresi Resmi Gazete'de yayımlanmasından itibaren kaç gündür?",
          "options": [
            "A) 90 gün",
            "B) 60 gün",
            "C) 45 gün",
            "D) 120 gün",
            "E) 30 gün"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. İptal davası açma süresi Resmi Gazete'de yayımlandığı tarihten itibaren 60 gündür."
        },
        {
          "id": "e9_q117",
          "no": 117,
          "subject": "Vatandaşlık",
          "text": "Adli yargı kolunun en yüksek temyiz inceleme mercii olan yüksek mahkeme hangisidir?",
          "options": [
            "A) Yargıtay",
            "B) Anayasa Mahkemesi",
            "C) Danıştay",
            "D) Uyuşmazlık Mahkemesi",
            "E) Sayıştay"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. Hukuk ve ceza mahkemelerinden verilen kararların son inceleme mercii Yargıtay'dır."
        },
        {
          "id": "e9_q118",
          "no": 118,
          "subject": "Vatandaşlık",
          "text": "İdare hukukunda merkezi yönetimin taşra teşkilatında 'İl Genel İdaresi'nin başında kim bulunur?",
          "options": [
            "A) Defterdar",
            "B) Kaymakam",
            "C) Belediye Başkanı",
            "D) Vali",
            "E) İl Genel Meclisi Başkanı"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. İl genel idaresinin başı ve devletin ildeki temsilcisi Vali'dir."
        },
        {
          "id": "e9_q119",
          "no": 119,
          "subject": "Vatandaşlık",
          "text": "657 Sayılı Devlet Memurları Kanunu'na göre memura 'görevinde ve davranışlarında daha dikkatli olması gerektiğinin yazı ile bildirilmesi' hangi disiplin cezasıdır?",
          "options": [
            "A) İhtar",
            "B) Uyarma",
            "C) Kınama",
            "D) Aylıktan kesme",
            "E) Kademe durdurma"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. 'Daha dikkatli olması gerektiğinin yazı ile bildirilmesi' Uyarma cezasının yasal tanımıdır."
        },
        {
          "id": "e9_q120",
          "no": 120,
          "subject": "Vatandaşlık",
          "text": "Türkiye Cumhuriyeti'nin 1952 yılında üye olduğu Kuzey Atlantik Antlaşması Örgütü (NATO) askeri ittifakının genel merkezi nerededir?",
          "options": [
            "A) Brüksel (Belçika)",
            "B) Paris (Fransa)",
            "C) Londra (İngiltere)",
            "D) Washington (ABD)",
            "E) Cenevre (İsviçre)"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. NATO'nun siyasi ve askeri genel karargahı Belçika'nın başkenti Brüksel'dedir."
        }
      ]
    },
    {
      "id": "deneme_10",
      "title": "10. Deneme (KPSS 2026 Tam Format - 120 Özgün Soru)",
      "questions": [
        {
          "id": "e10_q1",
          "no": 1,
          "subject": "Türkçe",
          "text": "\"Sahnede adını duyunca heyecandan <u>eli ayağı dolaştı</u>.\"\n\nBu cümledeki altı çizili deyimin cümleye kattığı anlam aşağıdakilerden hangisidir?",
          "options": [
            "A) Kendi çıkarlarını ön planda tutmak",
            "B) Aceleyle karar vermek",
            "C) Beklenmedik bir engelle karşılaşmak",
            "D) Heyecandan ne yapacağını şaşırmak",
            "E) Başkalarının fikrine saygı duymak"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. 'eli ayağı dolaşmak' deyimi Türkçede 'heyecandan ne yapacağını şaşırmak' anlamında kullanılır."
        },
        {
          "id": "e10_q2",
          "no": 2,
          "subject": "Türkçe",
          "text": "Yeni açılan tesisteki görevliler, dünkü toplantıda <u>birçok</u> (I) konuyu ele aldı. Projenin <u>kolleksiyon</u> (II) aşamasında bazı aksaklıklar yaşansa da ekip <u>özveriyle</u> (III) çalışarak <u>her şeyi</u> (IV) zamanında <u>teslim etti</u> (V).\n\nBu parçada numaralanmış altı çizili sözlerden hangisinin yazımı YANLIŞTIR?",
          "options": [
            "A) V",
            "B) III",
            "C) I",
            "D) II",
            "E) IV"
          ],
          "correct": 3,
          "solution": "Doğru cevap B'dir. 'kolleksiyon' sözcüğünün TDK kılavuzundaki doğru yazımı 'koleksiyon' şeklindedir."
        },
        {
          "id": "e10_q3",
          "no": 3,
          "subject": "Türkçe",
          "text": "Eski bir İstanbul konağının bahçesi ( ) asırlık çınarlar ( ) hanımelleri ve ıhlamur kokuları ( ) Burası insanın tüm yorgunluğunu unutturan bir sığınaktı ( )\n\nBu parçada parantezle belirtilen yerlere sırasıyla hangi noktalama işaretleri getirilmelidir?",
          "options": [
            "A) (;) (,) (,) (.)",
            "B) (:) (;) (...) (!)",
            "C) (,) (,) (.) (...)",
            "D) (:) (,) (...) (.)",
            "E) (,) (;) (.) (!)"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Bahçede bulunanlar açıklandığı için iki nokta (:), eş görevli ögeler arasına virgül (,), yüklemi olmayan eksiltili cümle sonuna üç nokta (...), tamamlanmış cümle sonuna nokta (.) konur."
        },
        {
          "id": "e10_q4",
          "no": 4,
          "subject": "Türkçe",
          "text": "\"Kitap okuma alışkanlığını erken yaşta edinen bireyler olayları çok daha derinlemesine kavrar.\"\n\nBu cümlenin anlam özelliği aşağıdakilerden hangisidir?",
          "options": [
            "A) Kanıtlanamaz bir varsayım bildirmektedir.",
            "B) Koşul-Sonuç ilişkisi içermektedir.",
            "C) Bir ön yargı ve kesin yargı bildirmektedir.",
            "D) Karşılaştırılan iki durum arasında çelişki kurmaktadır.",
            "E) Doğrudan bir tanım cümlesidir."
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Verilen cümlede eylemin gerekçesi ve yönelimi Koşul-Sonuç çerçevesinde kurulmuştur."
        },
        {
          "id": "e10_q5",
          "no": 5,
          "subject": "Türkçe",
          "text": "Fotoğraf çekmek, hayattan bir anı dondurmak gibi görünse de aslında bakan kişinin dünyaya hangi pencereden baktığının ilanıdır. İki kişi aynı manzaraya bakar fakat birinin çektiği kare sıradan bir görüntü iken diğerininki bir şiire dönüşür.\n\nBu parçada asıl anlatılmak istenen aşağıdakilerden hangisidir?",
          "options": [
            "A) Teknolojik imkânların geleneksel değerleri tehdit ettiği.",
            "B) Sanatçıların ekonomik kaygılarla hareket etmemesi gerektiği.",
            "C) Fotoğraf sanatında asıl belirleyici olanın teknik donanım değil, sanatçının şahsi bakış açısı ve duyarlılığı olduğu.",
            "D) Bireysel yeteneklerin ancak sıkı bir disiplinle açığa çıkabileceği.",
            "E) Toplumsal kuralların bireyin özgürlüğünü kısıtladığı."
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dır. Paragrafın bütününde ana fikir olarak 'Fotoğraf sanatında asıl belirleyici olanın teknik donanım değil, sanatçının şahsi bakış açısı ve duyarlılığı olduğu' savunulmaktadır."
        },
        {
          "id": "e10_q6",
          "no": 6,
          "subject": "Türkçe",
          "text": "Ses Bilgisi (Ünsüz Düşmesi): 'Küçücük' sözcüğünde hangi ses olayı gerçekleşmiştir?",
          "options": [
            "A) Benzeşme",
            "B) Ünsüz türemesi",
            "C) Kaynaşma",
            "D) Ünsüz düşmesi",
            "E) Ünlü düşmesi"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dir. Küçük-cük birleşirken k ünsüzü düşmüştür."
        },
        {
          "id": "e10_q7",
          "no": 7,
          "subject": "Türkçe",
          "text": "Ses Bilgisi (Ünsüz Yumuşaması): Aşağıdaki sözcüklerin hangisinde ünsüz yumuşaması kuralına aykırılık vardır?",
          "options": [
            "A) Kitabın kapağı",
            "B) Yurdun dört yanı",
            "C) Hukukun üstünlüğü",
            "D) Kalbin sesi",
            "E) Ağacın dalı"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. Yabancı kökenli 'hukuk' sözcüğü ünlüyle başlayan ek aldığında 'hukuğun' olmaz, k sert kalır."
        },
        {
          "id": "e10_q8",
          "no": 8,
          "subject": "Türkçe",
          "text": "Cümle Ögeleri: \"Güneş batarken sahil boyunca yürüyen yaşlı adam, eski günleri tebessümle andı.\" cümlesinde yüklemden önceki bölüm hangi ögedir?",
          "options": [
            "A) Belirtili Nesne",
            "B) Özne",
            "C) Edat Tümleci",
            "D) Dolaylı Tümleç",
            "E) Zarf Tümleci"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. 'Neyi andı?' -> 'eski günleri' (Belirtili Nesne)."
        },
        {
          "id": "e10_q9",
          "no": 9,
          "subject": "Türkçe",
          "text": "Sözcük Türü (Sıfat): Aşağıdaki cümlelerin hangisinde 'güzel' sözcüğü niteleme sıfatı olarak kullanılmıştır?",
          "options": [
            "A) Bugün hava ne güzel.",
            "B) Güzel bir ev satın aldılar.",
            "C) Şiiri çok güzel okudu.",
            "D) Güzel konuştuğu için herkes dinledi.",
            "E) Güzelin kahrı çekilmez."
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dir. 'Güzel ev' tamlamasında 'güzel' ismi niteleyen sıfattır."
        },
        {
          "id": "e10_q10",
          "no": 10,
          "subject": "Türkçe",
          "text": "Sözcük Türü (Zarf): Aşağıdaki cümlelerin hangisinde zaman zarfı kullanılmıştır?",
          "options": [
            "A) Yavaşça kapıyı kapattı.",
            "B) Koşarak içeri girdi.",
            "C) Yarın sabah erkenden yola çıkacağız.",
            "D) Çok çalışarak başardı.",
            "E) Aşağı indi."
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. 'Yarın sabah' eylemin zamanını bildirir."
        },
        {
          "id": "e10_q11",
          "no": 11,
          "subject": "Türkçe",
          "text": "Sözcük Türü (Zamir): Aşağıdaki cümlelerin hangisinde belgisiz zamir kullanılmıştır?",
          "options": [
            "A) Birkaçı sınava zamanında yetişemedi.",
            "B) Sen buraya gel.",
            "C) Kendi kendine konuşuyordu.",
            "D) Hangi soruyu çözemedin?",
            "E) Bu kitabı dün aldım."
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. 'Birkaçı' ismin yerini belirsiz şekilde tuttuğundan belgisiz zamirdir."
        },
        {
          "id": "e10_q12",
          "no": 12,
          "subject": "Türkçe",
          "text": "Fiil Çatısı (Geçişli): Aşağıdaki fiillerden hangisi nesne alabilen (geçişli) bir fiildir?",
          "options": [
            "A) Uyumak",
            "B) Ağlamak",
            "C) Dinlemek",
            "D) Gülmek",
            "E) Kaçmak"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. 'Onu dinlemek' denir; geçişlidir."
        },
        {
          "id": "e10_q13",
          "no": 13,
          "subject": "Türkçe",
          "text": "Fiil Çatısı (Edilgen): Aşağıdaki cümlelerin hangisinin yüklemi edilgen çatılıdır?",
          "options": [
            "A) Kuşlar gökyüzünde uçuştu.",
            "B) Çocuk annesini görünce sevindi.",
            "C) Sınıf bayram için özenle süslendi.",
            "D) Ali sabah erkenden yıkandı.",
            "E) Yaşlı adam pencereden etrafa bakındı."
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. Süsleme işini yapan belirsizdir, süslendi edilgendir."
        },
        {
          "id": "e10_q14",
          "no": 14,
          "subject": "Türkçe",
          "text": "Cümle Türleri (Birleşik): Aşağıdaki cümlelerin hangisi yapısına göre 'girişik birleşik' cümledir?",
          "options": [
            "A) Yağmur yağınca herkes saçak altlarına kaçıştı.",
            "B) Ankara'ya yarın gidecek.",
            "C) Bugün hava çok sıcak.",
            "D) Kapıyı açtı ve içeri girdi.",
            "E) Bize geldi ama fazla kalmadı."
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. İçinde fiilimsi ('yağınca') bulunan tek yüklemli cümle girişik birleşiktir."
        },
        {
          "id": "e10_q15",
          "no": 15,
          "subject": "Türkçe",
          "text": "Anlatım Bozukluğu: \"Hiçbir çalışan patronun sözünü dinlemiyor, kendi bildiğini yapıyordu.\" cümlesindeki anlatım bozukluğunun nedeni nedir?",
          "options": [
            "A) İkinci cümlede özne eksikliği (hepsi yapıyordu)",
            "B) Yüklem uyuşmazlığı",
            "C) Yanlış edat kullanımı",
            "D) Sözcüğün yanlış yerde kullanımı",
            "E) Nesne eksikliği"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. 'Hiçbiri' olumsuz özne olduğu için olumlu 'yapıyordu' yüklemine bağlanamaz; 'hepsi kendi bildiğini yapıyordu' denmelidir."
        },
        {
          "id": "e10_q16",
          "no": 16,
          "subject": "Türkçe",
          "text": "Paragraf (Akışı Bozan): (I) Bozkırda bahar kısa ama görkemlidir. (II) Karlar erir erimez her yer rengarenk çiçeklerle donanır. (III) Tarım arazilerinin sulanması için baraj inşaatları sürdürülmektedir. (IV) Ancak yazın sıcağı bastırınca bu cümbüş yerini sarı bir sessizliğe bırakır. (V) Doğa bir sonraki bahara kadar uykuya çekilir.\n\nAkışı bozan cümle hangisidir?",
          "options": [
            "A) II",
            "B) V",
            "C) I",
            "D) III",
            "E) IV"
          ],
          "correct": 3,
          "solution": "Doğru cevap C'dir. III. cümle doğa anlatımı arasına giren alakasız bir ekonomik faaliyettir."
        },
        {
          "id": "e10_q17",
          "no": 17,
          "subject": "Türkçe",
          "text": "Paragraf (İkiye Bölme): Bir metinde yeni bir düşünce veya konunun farklı bir boyutuna geçilen cümle paragrafı ikiye böler. Bu kurala göre metin mantıksal olarak nereden ayrılmalıdır?",
          "options": [
            "A) Konunun yön değiştirdiği cümleden",
            "B) En kısa cümleden",
            "C) İlk cümleden",
            "D) Soru cümlesinden",
            "E) En son cümleden"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. Paragraf bölme sorularında konu/bakış açısı değişikliği esastır."
        },
        {
          "id": "e10_q18",
          "no": 18,
          "subject": "Türkçe",
          "text": "Yazım Kuralı (Tarihler): Aşağıdakilerin hangisinde belirli bir tarih bildiren gün ve ay adlarının yazımı DOĞRUDUR?",
          "options": [
            "A) geçen pazartesi günü",
            "B) eylül ayında",
            "C) 29 Ekim 1923 Pazartesi",
            "D) 29 ekim 1923",
            "E) 1995 yılı haziranında"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. Belirli gün ve ay adları (rakamla belirtilen) büyük harfle başlar."
        },
        {
          "id": "e10_q19",
          "no": 19,
          "subject": "Türkçe",
          "text": "Yazım Kuralı (Bileşik Fiiller): Aşağıdaki cümlelerin hangisinde 'etmek/olmak' ile kurulan bileşik fiilin yazımı YANLIŞTIR?",
          "options": [
            "A) Yapılan yardımı <u>kabul etti</u>.",
            "B) Haberi duyunca <u>kahır oldu</u>.",
            "C) Bu durum beni çok <u>rahatsız etti</u>.",
            "D) Durumu hemen <u>fark etti</u>.",
            "E) Bütün borçlarını <u>terk etti</u>."
          ],
          "correct": 1,
          "solution": "Doğru cevap C'dir. Ses düşmesi olduğu için 'kahroldu' bitişik yazılmalıdır ('kahır oldu' yanlıştır)."
        },
        {
          "id": "e10_q20",
          "no": 20,
          "subject": "Türkçe",
          "text": "Söz Sanatları (Benzetme): \"Gözleri bir çift kömür gibi parlıyordu.\" cümlesinde hangi söz sanatı vardır?",
          "options": [
            "A) Mecaz-ı Mürsel",
            "B) Tezat",
            "C) İstiare",
            "D) Teşhis",
            "E) Teşbih (Benzetme)"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. 'Gibi' edatıyla kömüre benzetme yapılmıştır."
        },
        {
          "id": "e10_q21",
          "no": 21,
          "subject": "Türkçe",
          "text": "Söz Sanatları (Kişileştirme): \"Rüzgâr dağların ardından usulca fısıldadı.\" cümlesindeki söz sanatı nedir?",
          "options": [
            "A) Tariz",
            "B) Teşhis (Kişileştirme)",
            "C) Telmih",
            "D) Mübalağa",
            "E) Tenasüp"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dir. İnsana ait fısıldama özelliği rüzgâra verilmiştir."
        },
        {
          "id": "e10_q22",
          "no": 22,
          "subject": "Türkçe",
          "text": "Anlatım İlkeleri (Duruluk): Bir cümlede gereksiz sözcük kullanılmaması hangi anlatım ilkesidir?",
          "options": [
            "A) Duruluk",
            "B) Açıklık",
            "C) Doğallık",
            "D) Akıcılık",
            "E) Özgünlük"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. Gereksiz sözcükten arınmışlık 'duruluk'tur."
        },
        {
          "id": "e10_q23",
          "no": 23,
          "subject": "Türkçe",
          "text": "Anlatım İlkeleri (Açıklık): Cümlenin tek bir anlama gelmesi ve çok anlamlılık taşımaması hangi ilkedir?",
          "options": [
            "A) Açıklık",
            "B) Özlülük",
            "C) Akıcılık",
            "D) Yalınlık",
            "E) Duruluk"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. Herkesin aynı şeyi anlaması 'açıklık' ilkesidir."
        },
        {
          "id": "e10_q24",
          "no": 24,
          "subject": "Türkçe",
          "text": "Noktalama (Kesme İşareti): Aşağıdakilerin hangisinde kesme işareti (') YANLIŞ kullanılmıştır?",
          "options": [
            "A) Konya'ya",
            "B) Atatürk'ün ilkeleri",
            "C) 1923'te",
            "D) Türkler'in tarihi",
            "E) TBMM'nin kararı"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dir. Özel adlara gelen yapım ekleri ve çokluk eki (-ler) kesmeyle ayrılmaz: 'Türklerin' olmalıdır."
        },
        {
          "id": "e10_q25",
          "no": 25,
          "subject": "Türkçe",
          "text": "Noktalama (İki Nokta): Kendisinden sonra örnek verilecek cümlenin sonuna hangi noktalama işareti konur?",
          "options": [
            "A) Üç nokta (...)",
            "B) Noktalı virgül (;)",
            "C) Kısa çizgi (-)",
            "D) İki nokta (:)",
            "E) Virgül (,)"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dir. Örnek veya açıklama öncesinde iki nokta kullanılır."
        },
        {
          "id": "e10_q26",
          "no": 26,
          "subject": "Türkçe",
          "text": "Paragrafta Boşluk: Bir paragrafta 'Oysa' bağlacıyla başlayan cümle kendisinden önceki yargıyla nasıl bir ilişki kurar?",
          "options": [
            "A) Karşıtlık ve çelişki",
            "B) Örneklendirme",
            "C) Sıralama",
            "D) Sebep-sonuç",
            "E) Benzetme"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. 'Oysa' bağlacı önceki düşünceye zıt bir durumu bildirir."
        },
        {
          "id": "e10_q27",
          "no": 27,
          "subject": "Türkçe",
          "text": "Sözel Mantık (Eleme): Beş kişinin yarıştığı bir maratonda Ali, Veli'den önce; Can ise Ali'den önce bitirmiştir. Yarışın sonuncusu kim olamaz?",
          "options": [
            "A) Hepsi",
            "B) Diğerleri",
            "C) Can",
            "D) Bilinemez",
            "E) Veli"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. Can en az iki kişinin önünde olduğu için sonuncu olamaz."
        },
        {
          "id": "e10_q28",
          "no": 28,
          "subject": "Türkçe",
          "text": "Deyimler (Öfke): Aşağıdaki deyimlerden hangisi öfkelenmek anlamı taşımaz?",
          "options": [
            "A) Burnundan solumak",
            "B) Cinleri tepesine toplanmak",
            "C) Ağzı kulaklarına varmak",
            "D) Ateş püskürmek",
            "E) Tepesi atmak"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. 'Ağzı kulaklarına varmak' çok sevinmek demektir."
        },
        {
          "id": "e10_q29",
          "no": 29,
          "subject": "Türkçe",
          "text": "Atasözleri: 'Damlaya damlaya göl olur' atasözü hangi erdemi öğütler?",
          "options": [
            "A) Çalışkanlık",
            "B) Dürüstlük",
            "C) Tasarruf ve sabır",
            "D) Misafirperverlik",
            "E) Cesaret"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. Küçük birikimlerin zamanla büyüyeceğini, tasarrufu öğütler."
        },
        {
          "id": "e10_q30",
          "no": 30,
          "subject": "Türkçe",
          "text": "Metin Türleri: Yazarın güncel bir konuyu samimi bir dille, kanıtlama amacı gütmeden kaleme aldığı yazı türü hangisidir?",
          "options": [
            "A) Makale",
            "B) Deneme / Fıkra",
            "C) Tiyatro",
            "D) Biyografi",
            "E) Otobiyografi"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dir. Öznel ve samimi fikir yazısı denemedir."
        },
        {
          "id": "e10_q31",
          "no": 31,
          "subject": "Matematik",
          "text": "(1 - 1/3) · (1 - 1/4) · ... · (1 - 1/13)\n\nİşleminin sonucu kaçtır?",
          "options": [
            "A) 1/13",
            "B) 2/13",
            "C) 1/2",
            "D) 2/13",
            "E) 3/13"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Parantez içleri sadeleştiğinde ilk terimin payı (2) ile son terimin paydası (13) kalır: 2/13."
        },
        {
          "id": "e10_q32",
          "no": 32,
          "subject": "Matematik",
          "text": "2^(x) + 2^(x+1) = 6144 olduğuna göre x kaçtır?",
          "options": [
            "A) 12",
            "B) 14",
            "C) 11",
            "D) 13",
            "E) 10"
          ],
          "correct": 2,
          "solution": "Doğru cevap B'dir. 2^x(1 + 2) = 6144 => 3 · 2^x = 6144 => 2^x = 2048 = 2^11 => x = 11."
        },
        {
          "id": "e10_q33",
          "no": 33,
          "subject": "Matematik",
          "text": "√(144) + √(16) - √(9) işleminin sonucu kaçtır?",
          "options": [
            "A) 15",
            "B) 13",
            "C) 11",
            "D) 12",
            "E) 16"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. √144 = 12, √16 = 4, √9 = 3. 12 + 4 - 3 = 13."
        },
        {
          "id": "e10_q34",
          "no": 34,
          "subject": "Matematik",
          "text": "Ardışık üç çift tam sayının toplamı 96 olduğuna göre en küçük sayı kaçtır?",
          "options": [
            "A) 32",
            "B) 30",
            "C) 34",
            "D) 28",
            "E) 36"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. Sayılar x, x+2, x+4 olsun. 3x + 6 = 96 => 3x = 90 => x = 30."
        },
        {
          "id": "e10_q35",
          "no": 35,
          "subject": "Matematik",
          "text": "Dört basamaklı 10A-15 sayısı 9 ile tam bölünebilmektedir. Buna göre A rakamı kaçtır?",
          "options": [
            "A) 5",
            "B) 4",
            "C) 6",
            "D) 2",
            "E) 7"
          ],
          "correct": 1,
          "solution": "Doğru cevap B'dir. Rakamlar toplamı 9'un katı olmalıdır. e + A + (9 - e) + 5 = 14 + A => 14 + A = 18 => A = 4."
        },
        {
          "id": "e10_q36",
          "no": 36,
          "subject": "Matematik",
          "text": "32 ve 48 sayılarının EBOB'u kaçtır?",
          "options": [
            "A) 32",
            "B) 16",
            "C) 1",
            "D) 48",
            "E) 8"
          ],
          "correct": 1,
          "solution": "Doğru cevap A'dır. 32 = 16 · 2 ve 48 = 16 · 3 olup 2 ile 3 aralarında asaldır; EBOB = 16."
        },
        {
          "id": "e10_q37",
          "no": 37,
          "subject": "Matematik",
          "text": "-3 < 2x - 1 ≤ 25 eşitsizliğini sağlayan x tam sayılarının sayısı kaçtır?",
          "options": [
            "A) 14",
            "B) 12",
            "C) 15",
            "D) 11",
            "E) 13"
          ],
          "correct": 4,
          "solution": "Doğru cevap B'dir. -2 < 2x ≤ 26 => -1 < x ≤ 13. x tam sayıları: 0, 1, 2, ..., 13 olup toplam 14 değer değil, 13 tane pozitif ve 0 ile toplam 14 adettir."
        },
        {
          "id": "e10_q38",
          "no": 38,
          "subject": "Matematik",
          "text": "|x - 13| = 15 denklemini sağlayan x değerlerinin toplamı kaçtır?",
          "options": [
            "A) 30",
            "B) 13",
            "C) 0",
            "D) 15",
            "E) 26"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. |x - a| = b denkleminin kökleri a + b ve a - b olup toplamları daima 2a = 26 olur."
        },
        {
          "id": "e10_q39",
          "no": 39,
          "subject": "Matematik",
          "text": "Birbirine bağlı iki dişli çarktan büyüğünün 28 dişi, küçüğünün 14 dişi vardır. Büyük çark 10 tur attığında küçük çark kaç tur atar?",
          "options": [
            "A) 25",
            "B) 15",
            "C) 30",
            "D) 35",
            "E) 20"
          ],
          "correct": 4,
          "solution": "Doğru cevap B'dir. Diş sayısı ile tur sayısı ters orantılıdır: (2k) · 10 = k · x => x = 20 tur."
        },
        {
          "id": "e10_q40",
          "no": 40,
          "subject": "Matematik",
          "text": "Bir çiftlikte toplam 45 adet tavuk ve koyun bulunmaktadır. Bu hayvanların toplam ayak sayısı 130 olduğuna göre çiftlikte kaç koyun vardır?",
          "options": [
            "A) 24",
            "B) 18",
            "C) 25",
            "D) 22",
            "E) 20"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dır. Tavuk sayısı t, koyun k olsun. t + k = 45 ve 2t + 4k = 130. Çözüldüğünde k = 20 bulunur."
        },
        {
          "id": "e10_q41",
          "no": 41,
          "subject": "Matematik",
          "text": "Bir su deposunun 3/7'si doludur. Depoya 40 litre daha su eklenince deponun yarısı dolduğuna göre deponun tamamı kaç litre su alır?",
          "options": [
            "A) 420",
            "B) 480",
            "C) 600",
            "D) 520",
            "E) 560"
          ],
          "correct": 4,
          "solution": "Doğru cevap D'dir. Depo hacmi 14x olsun. Başlangıçta 6x doludur. 6x + 40 = 7x => x = 40. Depo tamamı = 14 · 40 = 560 litredir."
        },
        {
          "id": "e10_q42",
          "no": 42,
          "subject": "Matematik",
          "text": "Bir annenin bugünkü yaşı 44, çocuğunun yaşı ise 18'dir. Kaç yıl önce annenin yaşı çocuğunun yaşının 3 katıydı?",
          "options": [
            "A) 7",
            "B) 4",
            "C) 3",
            "D) 6",
            "E) 5"
          ],
          "correct": 4,
          "solution": "Doğru cevap C'dir. 44 - x = 3(18 - x) => 44 - x = 54 - 3x => 2x = 10 => x = 5 yıl önce."
        },
        {
          "id": "e10_q43",
          "no": 43,
          "subject": "Matematik",
          "text": "Bir usta bir günde 4 çift ayakkabı, kalfası ise bir günde 2 çift ayakkabı yapabilmektedir. İkisi birlikte 90 çift ayakkabıyı kaç günde bitirir?",
          "options": [
            "A) 16",
            "B) 14",
            "C) 18",
            "D) 15",
            "E) 12"
          ],
          "correct": 3,
          "solution": "Doğru cevap C'dir. Birlikte bir günde 4 + 2 = 6 çift ayakkabı yaparlar. 90 / 6 = 15 günde bitirirler."
        },
        {
          "id": "e10_q44",
          "no": 44,
          "subject": "Matematik",
          "text": "Aralarında 600 km mesafe bulunan iki şehirden hızları saatte 90 km ve 110 km olan iki araç aynı anda birbirine doğru hareket ederse kaç saat sonra karşılaşırlar?",
          "options": [
            "A) 3,5",
            "B) 2",
            "C) 4",
            "D) 3",
            "E) 2,5"
          ],
          "correct": 3,
          "solution": "Doğru cevap C'dir. t = Yol / (Hızlar Toplamı) = 600 / (90 + 110) = 600 / 200 = 3 saat."
        },
        {
          "id": "e10_q45",
          "no": 45,
          "subject": "Matematik",
          "text": "Maliyeti 300 TL olan bir ürün %25 kâr ile kaç TL'ye satılır?",
          "options": [
            "A) 355",
            "B) 365",
            "C) 395",
            "D) 375",
            "E) 385"
          ],
          "correct": 3,
          "solution": "Doğru cevap A'dır. Satış Fiyatı = 300 · 1,25 = 375 TL."
        },
        {
          "id": "e10_q46",
          "no": 46,
          "subject": "Matematik",
          "text": "Tuz oranı %30 olan 40 gram tuzlu su ile tuz oranı %50 olan 60 gram tuzlu su karıştırılıyor. Yeni karışımın tuz oranı yüzde kaçtır?",
          "options": [
            "A) %46",
            "B) %38",
            "C) %40",
            "D) %44",
            "E) %42"
          ],
          "correct": 4,
          "solution": "Doğru cevap C'dir. Tuz = (40 · 0,30) + (60 · 0,50) = 12 + 30 = 42 gram. Toplam karışım = 100 gram. Yüzde = %42."
        },
        {
          "id": "e10_q47",
          "no": 47,
          "subject": "Matematik",
          "text": "(115)² - (105)² işleminin sonucu kaçtır?",
          "options": [
            "A) 2200",
            "B) 2100",
            "C) 1800",
            "D) 2500",
            "E) 2400"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. a² - b² = (a - b)(a + b) = (10) · (220) = 2200."
        },
        {
          "id": "e10_q48",
          "no": 48,
          "subject": "Matematik",
          "text": "A ve B iki küme olmak üzere, s(A) = 12, s(B) = 15 ve s(A ∩ B) = 4 olduğuna göre s(A ∪ B) kaçtır?",
          "options": [
            "A) 31",
            "B) 25",
            "C) 23",
            "D) 27",
            "E) 21"
          ],
          "correct": 2,
          "solution": "Doğru cevap B'dir. s(A ∪ B) = s(A) + s(B) - s(A ∩ B) = 12 + 15 - 4 = 23."
        },
        {
          "id": "e10_q49",
          "no": 49,
          "subject": "Matematik",
          "text": "4, 6, 7, 7, 8, 9, 11 veri grubunun medyanı (ortancası) kaçtır?",
          "options": [
            "A) 7,5",
            "B) 7",
            "C) 8",
            "D) 9",
            "E) 6"
          ],
          "correct": 1,
          "solution": "Doğru cevap B'dir. Küçükten büyüğe sıralı 7 elemanlı grubun ortanca (4.) elemanı 7'dir."
        },
        {
          "id": "e10_q50",
          "no": 50,
          "subject": "Matematik",
          "text": "Bir torbada 4 mavi, 5 kırmızı ve 3 sarı bilye vardır. Rastgele çekilen bir bilyenin kırmızı olma olasılığı kaçtır?",
          "options": [
            "A) 5/12",
            "B) 1/2",
            "C) 5/7",
            "D) 1/4",
            "E) 1/3"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dır. Toplam bilye = 4 + 5 + 3 = 12. İstenen = 5 kırmızı. Olasılık = 5 / 12."
        },
        {
          "id": "e10_q51",
          "no": 51,
          "subject": "Matematik",
          "text": "Bir üçgenin iç açıları 3, 4 ve 5 sayıları ile orantılıdır. En küçük iç açı kaç derecedir?",
          "options": [
            "A) 45°",
            "B) 80°",
            "C) 50°",
            "D) 75°",
            "E) 60°"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. 3k + 4k + 5k = 180° => 12k = 180° => k = 15°. En küçük = 3 · 15° = 45°."
        },
        {
          "id": "e10_q52",
          "no": 52,
          "subject": "Matematik",
          "text": "Hipotenüsü 13 cm, bir dik kenarı 5 cm olan dik üçgenin diğer dik kenarı kaç cm'dir?",
          "options": [
            "A) 12",
            "B) 11",
            "C) 7",
            "D) 10",
            "E) 8"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. 5-12-13 özel dik üçgenidir; diğer kenar 12 cm'dir."
        },
        {
          "id": "e10_q53",
          "no": 53,
          "subject": "Matematik",
          "text": "Kenar uzunlukları 6 cm ve 8 cm olan bir dikdörtgenin köşegen uzunluğu kaç cm'dir?",
          "options": [
            "A) 14",
            "B) 12",
            "C) 10",
            "D) 9",
            "E) 15"
          ],
          "correct": 2,
          "solution": "Doğru cevap A'dir. 6-8-10 (3-4-5 üçgeninin 2 katı) dik üçgenidir; köşegen 10 cm'dir."
        },
        {
          "id": "e10_q54",
          "no": 54,
          "subject": "Matematik",
          "text": "Bir eşkenar üçgenin bir kenar uzunluğu 6 cm olduğuna göre çevresi kaç cm'dir?",
          "options": [
            "A) 36",
            "B) 24",
            "C) 12",
            "D) 30",
            "E) 18"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. Çevre = 3 · 6 = 18 cm."
        },
        {
          "id": "e10_q55",
          "no": 55,
          "subject": "Matematik",
          "text": "Alanı 81 cm² olan karenin çevresi kaç cm'dir?",
          "options": [
            "A) 36",
            "B) 40",
            "C) 32",
            "D) 48",
            "E) 27"
          ],
          "correct": 0,
          "solution": "Doğru cevap A'dir. Kenar a = √81 = 9 cm. Çevre = 4 · 9 = 36 cm."
        },
        {
          "id": "e10_q56",
          "no": 56,
          "subject": "Matematik",
          "text": "Düzgün bir altıgenin bir dış açısının ölçüsü kaç derecedir?",
          "options": [
            "A) 90°",
            "B) 72°",
            "C) 45°",
            "D) 120°",
            "E) 60°"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. Dış açı = 360° / 6 = 60°."
        },
        {
          "id": "e10_q57",
          "no": 57,
          "subject": "Matematik",
          "text": "İç açılarının toplamı 540° olan çokgen kaç kenarlıdır?",
          "options": [
            "A) 4",
            "B) 6",
            "C) 8",
            "D) 7",
            "E) 5 (Beşgen)"
          ],
          "correct": 4,
          "solution": "Doğru cevap A'dir. (n - 2) · 180° = 540° => n - 2 = 3 => n = 5."
