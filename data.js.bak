        {
          "id": "e6_q94",
          "no": 94,
          "subject": "Coğrafya",
          "text": "Kış mevsiminde Sibirya Yüksek Basıncı Türkiye'yi etkisi altına aldığında hava durumu nasıl seyreder?",
