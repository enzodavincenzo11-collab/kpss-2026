      },
      {
        "id": "e1_q43",
        "subject": "Matematik",
        "number": 43,
        "text": "43. Bir babanın bugünkü yaşı 38, oğlunun bugünkü yaşı ise 7'dır.\nBuna göre kaç yıl sonra babanın yaşı oğlunun yaşının 3 katı olur?",
        "options": [
          "A) 6",
          "B) 7",
          "C) 8",
          "D) 9",
          "E) 10"
        ],
        "correct": 2,
        "solution": "38 + t = 3(7 + t) => 38 + t = 21 + 3t => 2t = 17 => t = 8 yıl sonra."
